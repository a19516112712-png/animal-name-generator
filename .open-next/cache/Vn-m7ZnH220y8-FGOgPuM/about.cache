,\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"BreadcrumbList\\\",\\\"itemListElement\\\":[{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":1,\\\"name\\\":\\\"Home\\\",\\\"item\\\":\\\"https://bestanimalnames.com/\\\"},{\\\"@type\\\":\\\"ListItem\\\",\\\"position\\\":2,\\\"name\\\":\\\"About Us\\\",\\\"item\\\":\\\"https://bestanimalnames.com/about/\\\"}]}\"}}],[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"Organization\\\",\\\"name\\\":\\\"Animal Name Generator\\\",\\\"url\\\":\\\"https://bestanimalnames.com\\\",\\\"description\\\":\\\"Free animal name generator with 989+ animals. Browse thousands of name ideas.\\\",\\\"sameAs\\\":[\\\"https://www.pinterest.com/bestanimalnames/\\\"]}\"}}],[\"$\",\"nav\",null,{\"className\":\"max-w-7xl mx-auto px-4 py-3 text-sm text-gray-500 flex gap-1 flex-wrap\",\"aria-label\":\"Breadcrumb\",\"children\":[[\"$\",\"$L3\",null,{\"href\":\"/\",\"className\":\"hover:text-primary\",\"children\":\"Home\"}],[\"$\",\"span\",null,{\"className\":\"text-gray-300\",\"children\":\"/\"}],[\"$\",\"span\",null,{\"className\":\"text-gray-800 font-medium\",\"children\":\"About Us\"}]]}],[\"$\",\"section\",null,{\"className\":\"bg-gradient-to-br from-primary to-indigo-700 text-white\",\"children\":[\"$\",\"div\",null,{\"className\":\"max-w-7xl mx-auto px-4 py-14 text-center\",\"children\":[[\"$\",\"h1\",null,{\"className\":\"text-4xl font-extrabold mb-4\",\"children\":\"📖 About Animal Name Generator\"}],[\"$\",\"p\",null,{\"className\":\"text-indigo-100 text-lg max-w-xl mx-auto\",\"children\":\"Our mission is simple: help every animal lover find the perfect name — for free, forever.\"}]]}]}],[\"$\",\"section\",null,{\"className\":\"max-w-4xl mx-auto px-4 py-12 space-y-8 text-gray-600 leading-relaxed\",\"children\":[[\"$\",\"div\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-gray-800 mb-4\",\"children\":\"Our Story\"}],[\"$\",\"p\",null,{\"children\":\"Animal Name Generator was born from a simple observation: naming an animal should be joyful, not stressful. Whether you are welcoming a new puppy, creating a character for your novel, or searching for the ideal name for a classroom pet, the process should be inspiring and effortless. Too often, people find themselves scrolling through endless forum threads or generic lists that lack creativity. We decided to change that.\"}],[\"$\",\"p\",null,{\"className\":\"mt-3\",\"children\":\"Founded by a team of animal enthusiasts, writers, and developers, Animal Name Generator began as a modest collection of dog and cat names. Over time, fueled by user requests and our passion for wildlife, the collection expanded to include over 200 animal species — and we continue to grow every month. We are an independent project, not backed by any corporation or venture capital, which allows us to keep the site completely free and focused on user experience.\"}]]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-gray-800 mb-4\",\"children\":\"How Names Are Generated\"}],[\"$\",\"p\",null,{\"children\":\"Every name is hand-selected by our editorial team through a process combining research, creativity, and community feedback. We study naming conventions across cultures, explore mythology and folklore, review pop culture references, and analyze real-world pet naming trends. Our editors review each candidate name against quality criteria — ease of pronunciation, positive associations, distinctiveness, and appropriateness for the animal. We also incorporate user submissions, refreshing our collections regularly.\"}]]}],[\"$\",\"div\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-gray-800 mb-4\",\"children\":\"Name Categories\"}],[\"$\",\"p\",null,{\"children\":\"We organize names into eight categories: Male Names (strong, classic), Female Names (graceful, beautiful), Cute Names (adorable, sweet), Funny Names (witty, playful), Fantasy Names (magical, mythical), Unique Names (rare, distinctive), Cool Names (stylish, trendy), and Baby Names (tiny, precious). Each category provides 20 suggestions per animal — 160 total name ideas for every species.\"}]]}],\"$L12\",\"$L13\",\"$L14\"]}]],null,\"$L15\"]}]\n16:[]\ne:\"$W16\"\nf:[\"$\",\"$1\",\"h\",{\"children\":[null,[\"$\",\"$L17\",null,{\"children\":\"$L18\"}],[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$L19\",null,{\"children\":[\"$\",\"$1a\",null,{\"name\":\"Next.Metadata\",\"children\":\"$L1b\"}]}]}],null]}]\n11:[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/0_novvjei_gxi.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]\n1c:I[97367,[\"/_next/static/chunks/3i2zmhpv5m7u2.js\",\"/_next/static/chunks/14mrh2-p_w84d.js\"],\"OutletBoundary\"]\n12:[\"$\",\"div\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-gray-800 mb-4\",\"children\":\"Trust & Transparency\"}],[\"$\",\"p\",null,{\"children\":\"We believe in being completely open about how Animal Name Generator operates. The site is and will remain free — no hidden costs, no accounts required. We may display advertisements to support operational costs; these are clearly distinguished from content. All names are human-curated and reviewed. We do not use AI to generate names without human review. We are committed to accessibility, inclusivity, and maintaining a safe platform for everyone.\"}]]}]\n13:[\"$\",\"div\",null,{\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-gray-800 mb-4\",\"children\":\"Editorial Policy\"}],[\"$\",\"p\",null,{\"children\":\"Every animal name on BestAnimalNames.com is hand-curated by our editorial team. We source names from real pet owner submissions, veterinary naming databases, zoological references, and cultural naming traditions across different regions and languages. Each name is reviewed for pronunciation clarity, positive associations, uniqueness within its category, and suitability for the target animal species.\"}],[\"$\",\"p\",null,{\"className\":\"mt-3\",\"children\":\"Our blog content follows a rigorous research process. Articles are drafted by experienced writers, fact-checked against authoritative sources — including veterinary publications, zoological societies, and ethology research — and reviewed by our editorial team before publication. We cite sources where applicable and update articles regularly to reflect new research, naming trends, and reader feedback.\"}],[\"$\",\"p\",null,{\"className\":\"mt-3\",\"children\":[\"Content updates are maintained through our daily generation pipeline, which refreshes name collections, validates internal links, and ensures all pages remain accurate and accessible. We are committed to providing a trustworthy, high-quality resource that helps every animal lover find the perfect name — for free, forever. If you spot an error or have a suggestion, please \",[\"$\",\"$L3\",null,{\"href\":\"/contact/\",\"className\":\"text-primary hover:underline\",\"children\":\"contact us\"}],\".\"]}],[\"$\",\"p\",null,{\"className\":\"mt-3\",\"children\":[\"For more details on our quality standards, read our full \",[\"$\",\"$L3\",null,{\"href\":\"/editorial-policy/\",\"className\":\"text-primary hover:underline\",\"children\":\"Editorial Policy\"}],\" and learn \",[\"$\",\"$L3\",null,{\"href\":\"/how-we-create-content/\",\"className\":\"text-primary hover:underline\",\"children\":\"How We Create Content\"}],\" — including our research methodology, review process, and commitment to accuracy.\"]}]]}]\n14:[\"$\",\"div\",null,{\"className\":\"bg-blue-50 border border-blue-200 rounded-xl p-6 mt-6\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-lg font-bold text-blue-900 mb-2\",\"chi