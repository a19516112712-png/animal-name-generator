",\"span\",null,{\"className\":\"text-xs bg-primary/10 text-primary font-semibold px-2 py-0.5 rounded-full\",\"children\":\"Reptile Names\"}],[\"$\",\"h3\",null,{\"className\":\"text-sm font-bold text-gray-800 mt-2 group-hover:text-primary line-clamp-2\",\"children\":\"Reptile & Amphibian Naming Guide: 100+ Creative Names for Scales, Shells & Slime 🦎\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-gray-500 mt-1 line-clamp-2\",\"children\":\"From bearded dragons to dart frogs, discover 100+ creative names for reptiles and amphibians. Mythological, funny, cute, and fierce names for every cold-blooded companion.\"}]]}],[\"$\",\"$L3\",\"pet-naming-psychology-choose-meaningful-name\",{\"href\":\"/blog/pet-naming-psychology-choose-meaningful-name/\",\"className\":\"bg-white rounded-xl p-5 border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-3xl mb-3\",\"children\":\"🧠\"}],[\"$\",\"span\",null,{\"className\":\"text-xs bg-primary/10 text-primary font-semibold px-2 py-0.5 rounded-full\",\"children\":\"Naming Tips\"}],[\"$\",\"h3\",null,{\"className\":\"text-sm font-bold text-gray-800 mt-2 group-hover:text-primary line-clamp-2\",\"children\":\"The Psychology of Pet Naming: How to Choose a Name That Truly Fits\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-gray-500 mt-1 line-clamp-2\",\"children\":\"Explore the fascinating psychology behind pet naming. Learn how names shape your bond, influence behavior, and discover science-backed tips for choosing the perfect pet name.\"}]]}],[\"$\",\"$L3\",\"best-animal-names-by-habitat\",{\"href\":\"/blog/best-animal-names-by-habitat/\",\"className\":\"bg-white rounded-xl p-5 border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-3xl mb-3\",\"children\":\"🌍\"}],[\"$\",\"span\",null,{\"className\":\"text-xs bg-primary/10 text-primary font-