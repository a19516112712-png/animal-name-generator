]}]\n34:[\"$\",\"p\",\"17\",{\"className\":\"text-gray-700 leading-relaxed mb-4\",\"children\":[\"Primates & Mammals: Mountain Gorilla, Orangutan, Red Panda, Saola, Dhole, Black-footed Ferret. These names connect to our closest animal relatives and convey intelligence and warmth. For more naming inspiration, explore our \",[\"$\",\"$L3\",\"224\",{\"href\":\"/animal/red-handed-tamarin/\",\"className\":\"text-primary font-semibold hover:underline\",\"children\":[\"Red-Handed Tamarin\",\" Name Generator\"]}],\", \",[\"$\",\"$L3\",\"246\",{\"href\":\"/animal/bicolor-blenny/\",\"className\":\"text-primary font-semibold hover:underline\",\"children\":[\"Bicolor Blenny\",\" Name Generator\"]}],\", and \",[\"$\",\"$L3\",\"268\",{\"href\":\"/animal/sleeper-goby/\",\"className\":\"text-primary font-semibold hover:underline\",\"children\":[\"Sleeper Goby\",\" Name Generator\"]}],\" name collections.\"]}]\n35:[\"$\",\"p\",\"18\",{\"className\":\"text-gray-700 leading-relaxed mb-4\",\"children\":[\"Explore naming resources for \",[\"$\",\"$L3\",\"29\",{\"href\":\"/animal/anoa/\",\"className\":\"text-primary font-semibold hover:underline\",\"children\":[\"Anoa\",\" Name Generator\"]}],\", \",[\"$\",\"$L3\",\"37\",{\"href\":\"/animal/carmine-bee-eater/\",\"className\":\"text-primary font-semibold hover:underline\",\"children\":[\"Carmine Bee-Eater\",\" Name Generator\"]}],\", \",[\"$\",\"$L3\",\"58\",{\"href\":\"/animal/whites-tree-frog/\",\"className\":\"text-primary font-semibold hover:underline\",\"children\":[\"White's Tree Frog\",\" Name Generator\"]}],\", \",[\"$\",\"$L3\",\"78\",{\"href\":\"/animal/flasher-wrasse/\",\"className\":\"text-primary font-semibold hover:underline\",\"children\":[\"Flasher Wrasse\",\" Name Generator\"]}],\", \",[\"$\",\"$L3\",\"96\",{\"href\":\"/animal/serval/\",\"className\":\"text-primary font-semibold hover:underline\",\"children\":[\"Serval\",\" Name Generator\"]}],\", \",[\"$\",\"$L3\",\"106\",{\"href\":\"/animal/hognose-snake/\",\"className\