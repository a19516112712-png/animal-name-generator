}]]}],[\"$\",\"$L9\",\"kitten-names-cute-ideas-baby-cats\",{\"href\":\"/blog/kitten-names-cute-ideas-baby-cats/\",\"className\":\"bg-white rounded-xl p-5 border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group\",\"children\":[\"$L2f\",\"$L30\",\"$L31\",\"$L32\"]}],\"$L33\"]}]]}]\n27:[\"$\",\"nav\",null,{\"className\":\"mt-12 grid grid-cols-2 gap-4\",\"aria-label\":\"Post navigation\",\"children\":[[\"$\",\"$L9\",null,{\"href\":\"/blog/cute-hamster-names-for-kids/\",\"className\":\"bg-white rounded-xl p-4 border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group text-left\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs text-gray-500\",\"children\":\"← Previous Post\"}],[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold text-gray-700 group-hover:text-primary mt-1 line-clamp-1\",\"children\":\"Cute Hamster Names For Kids: 70+ Adorable & Easy-to-Say Ideas\"}]]}],[\"$\",\"$L9\",null,{\"href\":\"/blog/horse-names-inspired-by-nature/\",\"className\":\"bg-white rounded-xl p-4 border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group text-right\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs text-gray-500\",\"children\":\"Next Post →\"}],[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold text-gray-700 group-hover:text-primary mt-1 line-clamp-1\",\"children\":\"Horse Names Inspired By Nature: 80+ Beautiful Earth-Inspired Ideas\"}]]}]]}]\n28:[\"$\",\"div\",null,{\"className\":\"mt-12 p-6 bg-primary/5 rounded-2xl border border-primary/10 text-center\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-lg font-semibold text-gray-800 mb-2\",\"children\":\"🐾 Ready to find the perfect animal name?\"}],[\"$\",\"p\",null,{\"className\":\"text-gray-600 mb-4\",\"children\":\"Browse our complete collection of 200+ animal name generators — all 100% free.\"}],[\"$\",\"$L9\",null,{\"href\":\"/animals/\",\"className\":\"inline-block bg-primary text-white font-bold px-6 py-3 rounded-full hover:bg-primary-dark transition-colors\",\"children\":\"Browse All Animals →\"}]]}]\n2b:null\n2c:[\"$\",\"details\",\"7\",{\"className\":\"bg-gray-50 rounded-xl p-5 group\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"font-semibold cursor-pointer group-open:text-primary\",\"children\":\"What if my cat's movie name reference becomes dated?\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-gray-600 leading-relaxed\",\"children\":\"Great films are timeless. A cat named after a character from Citizen Kane, Alien, or Spirited Away will still read as clever in twenty years. Avoid naming after currently-trending streaming shows that may fade from cultural memory. Classics endure.\"}]]}]\n2d:[\"$\",\"details\",\"8\",{\"className\":\"bg-gray-50 rounded-xl p-5 group\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"font-semibold cursor-pointer group-open:text-primary\",\"children\":\"Should I match the movie character's gender to my cat's gender?\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-gray-600 leading-relaxed\",\"children\":\"Not necessary at all. Cats do not understand gender, and audiences are increasingly comfortable with gender-neutral naming. A female cat named Gandalf or a male cat named Ripley is perfectly fine and often more interesting than strictly gender-matched naming.\"}]]}]\n2e:[\"$\",\"details\",\"9\",{\"className\":\"bg-gray-50 rounded-xl p-5 group\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"font-semibold cursor-pointer group-open:text-primary\",\"children\":\"How do I introduce my cat with a movie name to non-film-fans?\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-gray-600 leading-relaxed\",\"children\":\"Just say the name confidently. Furiosa works as a cat name regardless of Mad Max knowledge. If people ask about the origin, you have a fun story to share. If they do not ask, the name stands perfectly well on its own merits.\"}]]}]\n2f:[\"$\",\"div\",null,{\"className