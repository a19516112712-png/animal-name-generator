en\":\"How to Name Your Ferret — Complete Guide 🦡\"}]]}]]}]]}]\n26:[\"$\",\"section\",null,{\"className\":\"mt-12\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold mb-6\",\"children\":\"📝 Related Articles\"}],[\"$\",\"div\",null,{\"className\":\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4\",\"children\":[[\"$\",\"$L9\",\"cat-names-by-personality\",{\"href\":\"/blog/cat-names-by-personality/\",\"className\":\"bg-white rounded-xl p-5 border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-3xl mb-3\",\"children\":\"🐱\"}],[\"$\",\"span\",null,{\"className\":\"text-xs bg-primary/10 text-primary font-semibold px-2 py-0.5 rounded-full\",\"children\":\"Cat Names\"}],[\"$\",\"h3\",null,{\"className\":\"text-sm font-bold text-gray-800 mt-2 group-hover:text-primary line-clamp-2\",\"children\":\"Cat Names by Personality Type: Find Your Feline's Perfect Match 🐱\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-gray-500 mt-1 line-clamp-2\",\"children\":\"Match your cat's one-of-a-kind personality with the perfect name. From regal rulers to goofy goofballs, cuddly lap cats to adventurous explorers — discover 150+ personality-matched cat names organized by temperament.\"}]]}],[\"$\",\"$L9\",\"unique-cat-names-stand-out\",{\"href\":\"/blog/unique-cat-names-stand-out/\",\"className\":\"bg-white rounded-xl p-5 border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-3xl mb-3\",\"children\":\"🐱\"}],[\"$\",\"span\",null,{\"className\":\"text-xs bg-primary/10 text-primary font-semibold px-2 py-0.5 rounded-full\",\"children\":\"Cat Names\"}],[\"$\",\"h3\",null,{\"className\":\"text-sm font-bold text-gray-800 mt-2 group-hover:text-primary line-clamp-2\",\"children\":\"50 Unique Cat Names That Will Make Your Feline Stand Out 🐱\"}],[\"$\",\"p\",null,{\"className\":\"text-x