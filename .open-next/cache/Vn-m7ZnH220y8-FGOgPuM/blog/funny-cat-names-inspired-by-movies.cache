ing Lory\\\"}]]}],[\\\"$\\\",\\\"$L3\\\",\\\"anole\\\",{\\\"href\\\":\\\"/animal/anole/\\\",\\\"className\\\":\\\"bg-white rounded-xl p-4 text-center border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"text-2xl mb-1\\\",\\\"children\\\":\\\"🦎\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"text-sm font-semibold text-gray-700 group-hover:text-primary\\\",\\\"children\\\":\\\"Anole\\\"}]]}],[\\\"$\\\",\\\"$L3\\\",\\\"skunk-clownfish\\\",{\\\"href\\\":\\\"/animal/skunk-clownfish/\\\",\\\"className\\\":\\\"bg-white rounded-xl p-4 text-center border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"text-2xl mb-1\\\",\\\"children\\\":\\\"🐠\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"text-sm font-semibold text-gray-700 group-hover:text-primary\\\",\\\"children\\\":\\\"Skunk Clownfish\\\"}]]}],[\\\"$\\\",\\\"$L3\\\",\\\"lilac-crowned-amazon\\\",{\\\"href\\\":\\\"/animal/lilac-crowned-amazon/\\\",\\\"className\\\":\\\"bg-white rounded-xl p-4 text-center border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"text-2xl mb-1\\\",\\\"children\\\":\\\"🦜\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"text-sm font-semibold text-gray-700 group-hover:text-primary\\\",\\\"children\\\":\\\"Lilac-Crowned Amazon\\\"}]]}],[\\\"$\\\",\\\"$L3\\\",\\\"honey-possum\\\",{\\\"href\\\":\\\"/animal/honey-possum/\\\",\\\"className\\\":\\\"bg-white rounded-xl p-4 text-center border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"text-2xl mb-1\\\",\\\"children\\\":\\\"🐾\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"te