7\\\",\\\"$L28\\\",\\\"$L29\\\",\\\"$L2a\\\",\\\"$L2b\\\",\\\"$L2c\\\",\\\"$L2d\\\",\\\"$L2e\\\",\\\"$L2f\\\",\\\"$L30\\\"]}],\\\"$L31\\\",\\\"$L32\\\",\\\"$L33\\\",\\\"$L34\\\",\\\"$L35\\\",\\\"$L36\\\"]}]\\n\"])</script><script>self.__next_f.push([1,\"23:[\\\"$\\\",\\\"$L3\\\",\\\"90\\\",{\\\"href\\\":\\\"/animal/goldfish/\\\",\\\"className\\\":\\\"text-primary font-semibold hover:underline\\\",\\\"children\\\":[\\\"Goldfish\\\",\\\" Name Generator\\\"]}]\\n24:[\\\"$\\\",\\\"$L3\\\",\\\"113\\\",{\\\"href\\\":\\\"/animal/turtle/\\\",\\\"className\\\":\\\"text-primary font-semibold hover:underline\\\",\\\"children\\\":[\\\"Turtle\\\",\\\" Name Generator\\\"]}]\\n25:[\\\"$\\\",\\\"$L3\\\",\\\"138\\\",{\\\"href\\\":\\\"/animal/axolotl/\\\",\\\"className\\\":\\\"text-primary font-semibold hover:underline\\\",\\\"children\\\":[\\\"Axolotl\\\",\\\" Name Generator\\\"]}]\\n26:[\\\"$\\\",\\\"h2\\\",\\\"2\\\",{\\\"className\\\":\\\"text-2xl font-bold mt-10 mb-4 text-gray-900\\\",\\\"children\\\":[\\\"Fish Names by Type 🐟\\\"]}]\\n27:[\\\"$\\\",\\\"p\\\",\\\"3\\\",{\\\"className\\\":\\\"text-gray-700 leading-relaxed mb-4\\\",\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"Different fish species inspire different naming styles. For elegant {betta-fish}: \\u003cstrong\\u003eNeptune\\u003c/strong\\u003e, \\u003cstrong\\u003ePoseidon\\u003c/strong\\u003e, \\u003cstrong\\u003eSapphire\\u003c/strong\\u003e, \\u003cstrong\\u003eVelvet\\u003c/strong\\u003e, \\u003cstrong\\u003eZephyr\\u003c/strong\\u003e, \\u003cstrong\\u003eLagoon\\u003c/strong\\u003e. Their flowing fins suggest graceful names: \\u003cstrong\\u003eAria\\u003c/strong\\u003e, \\u003cstrong\\u003eBallet\\u003c/strong\\u003e, \\u003cstrong\\u003eCascade\\u003c/strong\\u003e, \\u003cstrong\\u003eRipple\\u003c/strong\\u003e.\\\"}}]\\n28:[\\\"$\\\",\\\"p\\\",\\\"4\\\",{\\\"className\\\":\\\"text-gray-700 leading-relaxed mb-4\\\",\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"For playful {goldfish}: \\u003cstrong\\u003eBubbles\\u003c/strong\\u003e, \\u003cstrong\\u003eNemo\\u003c/strong\\u003e, \\u003cstrong\\u003eSunny\\u003c/strong\\u003e, \\u003cstrong\\u003eGoldie\\u003c/strong\\u003e, \\u003cstrong\\u003eFlash\\u003c/strong\\u003e, \\u003cstrong\\u003eClementine\\u003c/strong\\u003e. For {guppy} and tetra schools: group names like \\u003cstrong\\u003eThe Beatles\\u003c/strong\\u003e, \\u003cstrong\\u003eThe Spice Girls\\u003c/strong\\u003e, or gemstone collections — \\u003cstrong\\u003eRuby\\u003c/strong\\u003e, \\u003cstrong\\u003eOpal\\u003c/strong\\u003e, \\u003cstrong\\u003eTopaz\\u003c/strong\\u003e. For bottom-feeders like \\u003cstrong\\u003eplecos\\u003c/strong\\u003e and \\u003cstrong\\u003ecorydoras\\u003c/strong\\u003e: \\u003cstrong\\u003eHoover\\u003c/strong\\u003e, \\u003cstrong\\u003eSucker\\u003c/strong\\u003e, \\u003cstrong\\u003eDyson\\u003c/strong\\u003e.\\\"}}]\\n29:[\\\"$\\\",\\\"h2\\\",\\\"5\\\",{\\\"className\\\":\\\"text-2xl font-bold mt-10 mb-4 text-gray-900\\\",\\\"children\\\":[\\\"Turtle \\u0026 Aquatic Reptile Names 🐢\\\"]}]\\n2a:[\\\"$\\\",\\\"p\\\",\\\"6\\\",{\\\"className\\\":\\\"text-gray-700 leading-relaxed mb-4\\\",\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"Turtles and aquatic reptiles have outsized personalities in their shelled bodies. Classic turtle names: \\u003cstrong\\u003eMichelangelo\\u003c/strong\\u003e, \\u003cstrong\\u003eDonatello\\u003c/strong\\u003e, \\u003cstrong\\u003eLeonardo\\u003c/strong\\u003e, \\u003cstrong\\u003eRaphael\\u003c/strong\\u003e (TMNT!), \\u003cstrong\\u003eSquirt\\u003c/strong\\u003e, \\u003cstrong\\u003eCrush\\u003c/strong\\u003e, \\u003cstrong\\u003eTank\\u003c/strong\\u003e, \\u003cstrong\\u003eShelly\\u003c/strong\\u003e, \\u003cstrong\\u003eBowser\\u003c/strong\\u003e, \\u003cstrong\\u003eKoopa\\u003c/strong\\u003e.\\\"}}]\\n2b:[\\\"$\\\",\\\"p\\\",\\\"7\\\",{\\\"className\\\":\\\"text-gray-700 leading-relaxed mb-4\\\",\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"More creative options: \\u003cstrong\\u003eSheldon\\u003c/strong\\u003e (the Big Bang Theory), \\u003cstrong\\u003eFranklin\\u003c/strong\\u003e (the children's book turtle), \\u003cstrong\\u003eMock Turtle\\u003c/strong\\u003e (Alice in Wonderland), \\u003cstrong\\u003eMorla\\u003c/strong\\u003e (Neverending Story), \\u003cstrong\\u003eGamera\\u003c/strong\\u003e (kaiju turtle). Snapping turtles deserve tough names: \\u003cstrong\\u003eJaws\\u003c/strong\\u003e, \\u003cstrong\\u003eSnappy\\u003c/strong\\u003e, \\u003cstrong\\u003eChomp\\u003c/strong\\u003e, \\u003cstrong\\u003eBrutus\\u003c/strong\\u003e.\\\"}}]\\n2c:[\\\"$\\\",\\\"h2\\\",\\\"8\\\",{\\\"className\\\":\\\"text-2xl font-bold mt-10 mb-4 text-gray-900\\\",\\\"children\\\":[\\\"Aquatic Invertebrate Names 🦐\\\"]}]\\n2d:[\\\"$\\\",\\\"p\\\",\\\"9\\\",{\\\"className\\\":\\\"text-gray-700 leading-relaxed mb-4\\\",\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"Shrimp, snails, crabs, and crayfish add delightful variety to aquariums. For shrimp: \\u003cstrong\\u003eBubba Gump\\u003c/strong\\u003e, \\u003cstrong\\u003eScampi\\u003c/strong\\u003e, \\u003cstrong\\u003ePrawn\\u003c/strong\\u003e, \\u003cstrong\\u003eTempura\\u003c/strong\\u003e, \\u003cstrong\\u003eTiny\\u003c/strong\\u003e. For snails: \\u003cstrong\\u003eGary\\u003c/strong\\u003e (SpongeBob!), \\u003cstrong\\u003eTurbo\\u003c/strong\\u003e, \\u003cstrong\\u003eEscargot\\u003c/strong\\u003e, \\u003cstrong\\u003eShelly\\u003c/strong\\u003e, \\u003cstrong\\u003eZoom\\u003c/strong\\u003e. For crayfish and lobsters: \\u003cstrong\\u003ePinchy\\u003c/strong\\u003e, \\u003cstrong\\u003eClamps\\u003c/strong\\u003e, \\u003cstrong\\u003eRed\\u003c/strong\\u003e, \\u003cstrong\\u003eRock Lobster\\u003c/strong\\u003e.\\\"}}]\\n2e:[\\\"$\\\",\\\"h2\\\",\\\"10\\\",{\\\"className\\\":\\\"text-2xl font-bold mt-10 mb-4 text-gray-900\\\",\\\"children\\\":[\\\"Themed Aquatic Names 🌊\\\"]}]\\n2f:[\\\"$\\\",\\\"p\\\",\\\"11\\\",{\\\"className\\\":\\\"text-gray-700 leading-relaxed mb-4\\\",\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"Ocean mythology names carry majesty: \\u003cstrong\\u003eTriton\\u003c/strong\\u003e, \\u003cstrong\\u003eCalypso\\u003c/strong\\u003e, \\u003cstrong\\u003eNereus\\u003c/strong\\u003e, \\u003cstrong\\u003eThalassa\\u003c/strong\\u003e, \\u003cstrong\\u003eOndine\\u003c/strong\\u003e, \\u003cstrong\\u003eNjord\\u003c/strong\\u003e (Norse sea god). Geographic waters: \\u003cstrong\\u003eNile\\u003c/strong\\u003e, \\u003cstrong\\u003eAmazon\\u003c/strong\\u003e, \\u003cstrong\\u003eDanube\\u003c/strong\\u003e, \\u003cstrong\\u003eCaspian\\u003c/strong\\u003e, \\u003cstrong\\u003ePacific\\u003c/strong\\u003e, \\u003cs\"])</script><script>self.__next_f.push([1,\"trong\\u003eHudson\\u003c/strong\\u003e. Coral reef vibes: \\u003cstrong\\u003eReef\\u003c/strong\\u003e, \\u003cstrong\\u003eAtoll\\u003c/strong\\u003e, \\u003cstrong\\u003eLagoon\\u003c/strong\\u003e, \\u003cstrong\\u003eTide\\u003c/strong\\u003e, \\u003cstrong\\u003eMangrove\\u003c/strong\\u003e.\\\"}}]\\n30:[\\\"$\\\",\\\"p\\\",\\\"12\\\",{\\\"className\\\":\\\"text-gray-700 leading-relaxed mb-4\\\",\\\"dangerouslySetInnerHTML\\\":{\\\"__html\\\":\\\"Bioluminescent deep-sea names: \\u003cstrong\\u003eAbyss\\u003c/strong\\u003e, \\u003cstrong\\u003eGlimmer\\u003c/strong\\u003e, \\u003cstrong\\u003ePhosphor\\u003c/strong\\u003e, \\u003cstrong\\u003eLantern\\u003c/strong\\u003e, \\u003cstrong\\u003eTwilight\\u003c/strong\\u003e. Pirate-themed names: \\u003cstrong\\u003eCaptain\\u003c/strong\\u003e, \\u003cstrong\\u003eCorsair\\u003c/strong\\u003e, \\u003cstrong\\u003eBlackbeard\\u003c/strong\\u003e, \\u003cstrong\\u003eCalico Jack\\u003c/strong\\u003e, \\u003cstrong\\u003eBuccaneer\\u003c/strong\\u003e. Shipwreck names: \\u003cstrong\\u003eTitanic\\u003c/strong\\u003e, \\u003cstrong\\u003eLusitania\\u003c/strong\\u003e (for fish that survived!), \\u003cstrong\\u003eMarie Celeste\\u003c/strong\\u003e.\\\"}}]\\n\"])</script><script>self.__next_f.push(