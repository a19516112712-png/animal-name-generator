\"}]]}],[\"$\",\"$L3\",\"gerbil\",{\"href\":\"/animal/gerbil/\",\"className\":\"bg-white rounded-xl p-4 text-center border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-2xl mb-1\",\"children\":\"🐭\"}],[\"$\",\"div\",null,{\"className\":\"text-sm font-semibold text-gray-700 group-hover:text-primary\",\"children\":\"Gerbil\"}]]}],[\"$\",\"$L3\",\"freshwater-angelfish\",{\"href\":\"/animal/freshwater-angelfish/\",\"className\":\"bg-white rounded-xl p-4 text-center border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group\",\"children\":[\"$L39\",\"$L3a\"]}]]}]]}]\n34:[\"$\",\"section\",null,{\"className\":\"mt-12\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold mb-6\",\"children\":\"📖 Related Naming Guides\"}],[\"$\",\"div\",null,{\"className\":\"grid grid-cols-1 sm:grid-cols-2 gap-3\",\"children\":[[\"$\",\"$L3\",\"african-animal-names\",{\"href\":\"/guide/african-animal-names/\",\"className\":\"bg-white rounded-xl p-4 border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group flex items-center gap-3\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-2xl\",\"children\":\"📖\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold text-gray-700 group-hover:text-primary\",\"children\":\"African Animal Names — 100+ Beautiful Ideas 🌍\"}]]}],[\"$\",\"$L3\",\"how-to-name-your-sheep\",{\"href\":\"/guide/how-to-name-your-sheep/\",\"className\":\"bg-white rounded-xl p-4 border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group flex items-center gap-3\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-2xl\",\"children\":\"📖\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold text-gray-700 group-hover:text-primary\",\"children\":\"How to Name Your Sheep — Complete Guide 🐑\"}]]}],[\"$\",\"$L3\",\"funny-fish-names\",{\"href