l names organized by every shade of the rainbow.\"}]]}],[\"$\",\"$L3\",\"best-animal-names-inspired-by-mythology\",{\"href\":\"/blog/best-animal-names-inspired-by-mythology/\",\"className\":\"bg-white rounded-xl p-5 border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-3xl mb-3\",\"children\":\"⚡\"}],[\"$\",\"span\",null,{\"className\":\"text-xs bg-primary/10 text-primary font-semibold px-2 py-0.5 rounded-full\",\"children\":\"Naming Tips\"}],[\"$\",\"h3\",null,{\"className\":\"text-sm font-bold text-gray-800 mt-2 group-hover:text-primary line-clamp-2\",\"children\":\"Best Animal Names Inspired by Mythology: Gods, Heroes & Legends ⚡\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-gray-500 mt-1 line-clamp-2\",\"children\":\"Name your pet after the gods, heroes, and mythical creatures of world mythology. From Greek and Norse to Egyptian and Japanese legends, find powerful, meaningful names.\"}]]}],\"$L3b\",\"$L3c\"]}]]}]\n36:[\"$\",\"nav\",null,{\"className\":\"mt-12 grid grid-cols-2 gap-4\",\"aria-label\":\"Post navigation\",\"children\":[[\"$\",\"$L3\",null,{\"href\":\"/blog/best-animal-names-for-farm-animals/\",\"className\":\"bg-white rounded-xl p-4 border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group text-left\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs text-gray-500\",\"children\":\"← Previous Post\"}],[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold text-gray-700 group-hover:text-primary mt-1 line-clamp-1\",\"children\":\"Best Animal Names for Farm Animals: 150+ Barnyard Ideas 🚜\"}]]}],[\"$\",\"$L3\",null,{\"href\":\"/blog/best-animal-names-for-baby-animals/\",\"className\":\"bg-white rounded-xl p-4 border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group text-right\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs text-gray-500\",\"children\":\"N