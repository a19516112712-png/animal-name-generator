me\":\"text-2xl font-bold mb-6\",\"children\":\"📝 Related Articles\"}],[\"$\",\"div\",null,{\"className\":\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4\",\"children\":[[\"$\",\"$L3\",\"horse-names-inspired-by-nature\",{\"href\":\"/blog/horse-names-inspired-by-nature/\",\"className\":\"bg-white rounded-xl p-5 border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-3xl mb-3\",\"children\":\"🌿\"}],[\"$\",\"span\",null,{\"className\":\"text-xs bg-primary/10 text-primary font-semibold px-2 py-0.5 rounded-full\",\"children\":\"Horse Names\"}],[\"$\",\"h3\",null,{\"className\":\"text-sm font-bold text-gray-800 mt-2 group-hover:text-primary line-clamp-2\",\"children\":\"Horse Names Inspired By Nature: 80+ Beautiful Earth-Inspired Ideas\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-gray-500 mt-1 line-clamp-2\",\"children\":\"Discover horse names inspired by nature that capture the beauty of the outdoors. From mountain peaks to flowing rivers, find 80+ nature-inspired names for your majestic equine companion.\"}]]}],[\"$\",\"$L3\",\"the-ultimate-guide-to-playful-snowy-owl-names-175-ideas-for-every-snowy-owl-owner\",{\"href\":\"/blog/the-ultimate-guide-to-playful-snowy-owl-names-175-ideas-for-every-snowy-owl-owner/\",\"className\":\"bg-white rounded-xl p-5 border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-3xl mb-3\",\"children\":\"🐾\"}],[\"$\",\"span\",null,{\"className\":\"text-xs bg-primary/10 text-primary font-semibold px-2 py-0.5 rounded-full\",\"children\":\"Snowy Owl Names\"}],[\"$\",\"h3\",null,{\"className\":\"text-sm font-bold text-gray-800 mt-2 group-hover:text-primary line-clamp-2\",\"children\":\"The Ultimate Guide to Playful Snowy Owl Names: 175+ Ideas for Every Snowy Owl Owner\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-gray-500 mt-1 line-clamp-2