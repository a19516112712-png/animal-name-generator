b-8\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-lg font-bold text-gray-800 mb-4\",\"children\":\"📋 Table of Contents\"}],[\"$\",\"ol\",null,{\"className\":\"space-y-2 list-none pl-0\",\"children\":[[\"$\",\"li\",\"0\",{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-primary font-bold mt-0.5 min-w-[1.5em]\",\"children\":[1,\".\"]}],[\"$\",\"a\",null,{\"href\":\"#intro\",\"className\":\"text-gray-700 hover:text-primary hover:underline transition-colors text-sm leading-relaxed\",\"children\":\"Why Choose an International Name\"}]]}],[\"$\",\"li\",\"1\",{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-primary font-bold mt-0.5 min-w-[1.5em]\",\"children\":[2,\".\"]}],[\"$\",\"a\",null,{\"href\":\"#japanese\",\"className\":\"text-gray-700 hover:text-primary hover:underline transition-colors text-sm leading-relaxed\",\"children\":\"Japanese Pet Names — Elegant & Meaningful\"}]]}],[\"$\",\"li\",\"2\",{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-primary font-bold mt-0.5 min-w-[1.5em]\",\"children\":[3,\".\"]}],[\"$\",\"a\",null,{\"href\":\"#nordic\",\"className\":\"text-gray-700 hover:text-primary hover:underline transition-colors text-sm leading-relaxed\",\"children\":\"Scandinavian & Nordic Names — Strong & Mythical\"}]]}],[\"$\",\"li\",\"3\",{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-primary font-bold mt-0.5 min-w-[1.5em]\",\"children\":[4,\".\"]}],[\"$\",\"a\",null,{\"href\":\"#latin\",\"className\":\"text-gray-700 hover:text-primary hover:underline transition-colors text-sm leading-relaxed\",\"children\":\"Italian, Spanish & French Names — Romantic & Musical\"}]]}],[\"$\",\"li\",\"4\",{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-primary font-bold mt-0.5 min-w-[1.5em]\",\"children\":[5,\".\"]}],[\"$\",\"a\",null,{\"href\":\"#celtic\",\"className\":\"text-gray-700 hover:text-primary hover:underline transition-colors text-sm leading-relaxed\",\"children\":\"Celtic & Irish Names — Ancient & Poetic\"}]]}],\"$L23\",\"$L24\",\"$L25\"]}]]}],\"$L26\",\"$L27\",\"$L28\",\"$L29\",\"$L2a\",\"$L2b\",\"$L2c\",\"$L2d\",\"$L2e\",\"$L2f\",\"$L30\",\"$L31\",\"$L32\",\"$L33\",\"$L34\"]}],\"$L35\",\"$L36\",\"$L37\",\"$L38\",\"$L39\",\"$L3a\"]}]\n23:[\"$\",\"li\",\"5\",{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-primary font-bold mt-0.5 min-w-[1.5em]\",\"children\":[6,\".\"]}],[\"$\",\"a\",null,{\"href\":\"#african\",\"className\":\"text-gray-700 hover:text-primary hover:underline transition-colors text-sm leading-relaxed\",\"children\":\"African & Swahili Names — Powerful & Distinctive\"}]]}]\n24:[\"$\",\"li\",\"6\",{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-primary font-bold mt-0.5 min-w-[1.5em]\",\"children\":[7,\".\"]}],[\"$\",\"a\",null,{\"href\":\"#tips\",\"className\":\"text-gray-700 hover:text-primary hover:underline transition-colors text-sm leading-relaxed\",\"children\":\"Tips for Choosing International Names\"}]]}]\n25:[\"$\",\"li\",\"7\",{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-primary font-bold mt-0.5 min-w-[1.5em]\",\"children\":[8,\".\"]}],[\"$\",\"a\",null,{\"href\":\"#faq\",\"className\":\"text-gray-700 hover:text-primary hover:underline transition-colors text-sm leading-relaxed\",\"children\":\"FAQ\"}]]}]\n26:[\"$\",\"h2\",\"2\",{\"className\":\"text-2xl font-bold mt-10 mb-4 text-gray-900\",\"children\":[\"🌍 Why Choose an International Name\"]}]\n27:[\"$\",\"p\",\"3\",{\"className\":\"text-gray-700 leading-relaxed mb-4\",\"children\":[\"There is something genuinely magical about giving your pet a name that carries the weight and beauty of another language, another culture, another way of seeing the world. International pet names do more than just identify your animal companion — they tell a story about where the name comes from, what it means, and why it resonated with you. A Japanese name like Yuki, meaning snow, is not just a pretty sound — it carries centuries of Japanese aesthetic tradition, the cultural value placed on natural beauty, and the poetry of a single word capturing an entire season.\"]}]\n28:[\"$\",\"p\",\"4\",{\"className\":\"text-gray-700 leading-relaxed mb-4\",\"children\":[\"The globalization of culture through streaming entertainment, international travel, and social media has made cross-cultural naming more accessible and more meaningful than ever before. Pet owners are no longer limited to names from their immediate cultural surroundings. A dog in Ohio can carry a Swahili name meaning strength. A cat in London can answer to a Japanese name meaning moonlight. These names celebrate our interconnected world and the rich diversity of human language and culture.\"]}]\n29:[\"$\",\"p\",\"5\",{\"className\":\"text-gray-700 leading-relaxed mb-4\",\"children\":[\"Beyond their beauty and meaning, international names offer a practical advantage: uniqueness. While there might be five dogs named Max at your local park, there is almost certainly only one named Kazuki or Makena. If standing out matters to you, international names provide a nearly endless source of distinctive, meaningful options that are unlikely to be duplicated in your immediate social circle. In this guide, we have curated 120 names from across the globe, organized by region and cultural tradition.\"]}]\n2a:[\"$\",\"h2\",\"6\",{\"className\":\"text-2xl font-bold mt-10 mb-4 text-gray-900\",\"children\":[\"🇯🇵 Japanese Pet Names — Elegant & Meaningful\"]}]\n2b:[\"$\",\"p\",\"7\",{\"className\":\"text-gray-700 leading-relaxed mb-4\",\"children\":[\"Japanese names hold special appeal for pet owners worldwide. The language's structure — with its clean syllables, beautiful meanings, and connection to nature and aesthetics — produces names that are both beautiful to hear and rich with significance. Japanese naming conventions often draw from the natural world, making them particularly suitable for pets who connect us more deeply to nature and the simple joys of companionship.\"]}]\n2c:[\"$\",\"p\",\"8\",{\"className\":\"text-gray-700 leading-relaxed mb-4\",\"children\":[\"Yuki, meaning snow, is a timeless choice — pure, clean, and evocative of winter beauty. It works beautifully for white pets but carries enough meaning to transcend color. Sora, meaning sky, suggests boundless freedom and open horizons, perfect for adventurous spirits. Hana, meaning flower, captures delicate beauty and the fleeting preciousness of life. Kumo, meaning cloud, is whimsical and light. Tora, meaning tiger, suits confident, striped, or particularly fierce small pets with larger-than-life personalities. Kenji, meaning strong and wise, brings gravitas and dignity.\"]}]\n2d:[\"$\",\"p\",\"9\",{\"className\":\"text-gray-700 leading-relaxed mb-4\",\"children\":[\"Nature-inspired Japanese names form a particularly rich category: Sakura (cherry blossom), Ren (lotus), Umi (ocean), Mori (forest), Kaze (wind), Tsuki (moon), and Nami (wave) all carry the deep Japanese cultural appreciation for the natural world. These names work across breeds and species, bringing a touch of Japanese aesthetic sensibility to your daily life with your pet.\"]}]\n2e:[\"$\",\"h2\",\"10\",{\"className\":\"text-2xl font-bold mt-10 mb-4 text-gray-900\",\"children\":[\"⚔️ Scandinavian & Nordic Names — Strong & Mythical\"]}]\n2f:[\"$\",\"p\",\"11\",{\"className\":\"text-gray-700 leading-relaxed mb-4\",\"children\":[\"Nordic and Scandinavian names draw from Viking history, Norse mythology, and the stark beauty of northern landscapes. These names carry a sense of strength, adventure, and connection to ancient traditions that make them incredibly appealing for pets with bold personalities or striking appearances. A name like Freya, the Norse goddess of love and war, or Odin, the All-Father of the Norse pantheon, immediately establishes presence and character.\"]}]\n30:[\"$\",\"p\",\"12\",{\"className\":\"text-gray-700 leading-relaxed mb-4\",\"children\":[\"For dogs, Nordic names are particularly popular and fitting. Loki, the trickster god, suits clever, mischievous dogs who always seem to be one step ahead of you. Thor, god of thunder, matches powerful, protective breeds. Freya works beautifully for loving but fierce female dogs. Fenrir, the giant wolf of Norse mythology, is perfect for wolf-like breeds or particularly large, majestic dogs. Other strong options include Bjorn (bear), Saga (storyteller), Astrid (divine beauty), and Leif (heir or descendant).\"]}]\n31:[\"$\",\"p\",\"13\",{\"className\":\"text-gray-700 leading-relaxed mb-4\",\"children\":[\"Geographic Nordic names also offer wonderful options: Oslo, Bergen, Fjord, and Nordic nature words like Vinter (winter), Snø (snow), and Storm all carry the dramatic beauty of Scandinavian landscapes. These names work especially well for cold-weather breeds like Huskies, Malamutes, and Norwegian Elkhounds, but their powerful sound makes them versatile across all breeds and species.\"]}]\n32:[\"$\",\"h2\",\"14\",{\"className\":\"text-2xl font-bold mt-10 mb-4 text-gray-900\",\"children\":[\"🔗 Explore More Unique Names\"]}]\n33:[\"$\",\"p\",\"15\",{\"className\":\"text-gray-700 leading-relaxed mb-4\",\"children\":[\"Explore our name generators for \",[\"$\",\"$L3\",\"32\",{\"href\":\"/animal/alpaca-huacaya/\",\"className\":\"text-primary font-semibold hover:underline\",\"children\":[\"Huacaya Alpaca\",\" Name Generator\"]}],\", \",[\"$\",\"$L3\",\"50\",{\"href\":\"/animal/anatolian-leopard/\",\"className\":\"text-primary font-semibold hover:underline\",\"children\":[\"Anatolian Leopard\",\" Name Generator\"]}],\", \",[\"$\",\"$L3\",\"71\",{\"href\":\"/animal/alpine-salamander/\",\"className\":\"text-primary font-semibold hover:underline\",\"children\":[\"Alpine Salamander\",\" Name Generator\"]}],\", \",[\"$\",\"$L3\",\"92\",{\"href\":\"/animal/african-grey-parrot/\",\"className\":\"text-primary font-semibold hover:underline\",\"children\":[\"African Grey Parrot\",\" Name Generator\"]}],\", and \",[\"$\",\"$L3\",\"119\",{\"href\":\"/animal/amazon-parrot/\",\"className\":\"text-primary font-semibold hover:underline\",\"children\":[\"Amazon Parrot\",\" Name Generator\"]}],\" to find the perfect name for your companion.\"]}]\n34:[\"$\",\"p\",\"16\",{\"className\":\"text-gray-700 leading-relaxed mb-4\",\"children\":[\"Browse our complete collection of unique pet names: dog names, cat names, and all 989 animal species with 160-plus names each. For naming guides: how to choose unique names, international naming traditions, and complete naming strategies.\"]}]\n35:[\"$\",\"section\",null,{\"className\":\"mt-12 bg-white rounded-2xl p-6 border border-gray-100\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold mb-6\",\"children\":\"❓ Frequently Asked Questions\"}],[\"$\",\"div\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"bg-gray-50 rounded-xl p-5 group\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"font-semibold cursor-pointer group-open:text-primary\",\"children\":\"How do I make sure I am pronouncing an international name correctly?\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-gray-600 leading-relaxed\",\"children\":\"Take the time to learn the correct pronunciation before committing. Listen to native speakers on language learning apps or YouTube. A name loses its beauty and cultural significance if consistently mispronounced. Many international names have intuitive pronunciations, but verifying ensures you honor the name's origins properly.\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"bg-gray-50 rounded-xl p-5 group\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"font-semibold cursor-pointer group-open:text-primary\",\"children\":\"Is cultural appropriation a concern with international pet names?\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-gray-600 leading-relaxed\",\"children\":\"Using names from other cultures is generally considered cultural appreciation rather than appropriation when done respectfully. The key is understanding the name's meaning and cultural significance, using it correctly, and being able to explain its origins when asked. Avoid names with sacred religious significance unless you have a genuine personal or cultural connection to that tradition.\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"bg-gray-50 rounded-xl p-5 group\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"font-semibold cursor-pointer group-open:text-primary\",\"children\":\"Will my pet respond to a name from another language?\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-gray-600 leading-relaxed\",\"children\":\"Absolutely. Your pet does not know or care what language their name comes from — they simply learn to associate that specific sound pattern with attention, treats, and positive experiences. Phonetically, international names often work very well for pets because many feature the clear vowel and consonant sounds that animals recognize most easily.\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"bg-gray-50 rounded-xl p-5 group\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"font-semibold cursor-pointer group-open:text-primary\",\"children\":\"What are the most popular countries of origin for pet names in 2025?\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-gray-600 leading-relaxed\",\"children\":\"Japanese names are currently the fastest-growing international category, driven by the global popularity of anime and Japanese culture. Scandinavian names remain consistently popular, especially for dogs. Italian and French names are classics that never go out of style. Korean names are rising rapidly with the global spread of K-pop and K-drama fandom.\"}]]}]]}]]}]\n36:[\"$\",\"section\",null,{\"className\":\"mt-12\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold mb-6\",\"children\":\"🐾 Related Animal Name Generators\"}],[\"$\",\"div\",null,{\"className\":\"grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3\",\"children\":[[\"$\",\"$L3\",\"lilac-crowned-amazon\",{\"href\":\"/animal/lilac-crowned-amazon/\",\"className\":\"bg-white rounded-xl p-4 text-center border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-2xl mb-1\",\"children\":\"🦜\"}],[\"$\",\"div\",null,{\"className\":\"text-sm font-semibold text-gray-700 group-hover:text-primary\",\"children\":\"Lilac-Crowned Amazon\"}]]}],[\"$\",\"$L3\",\"tamarin\",{\"href\":\"/animal/tamarin/\",\"className\":\"bg-white rounded-xl p-4 text-center border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-2xl mb-1\",\"children\":\"🐒\"}],[\"$\",\"div\",null,{\"className\":\"text-sm font-semibold text-gray-700 group-hover:text-primary\",\"children\":\"Tamarin\"}]]}],[\"$\",\"$L3\",\"tilapia\",{\"href\":\"/animal/tilapia/\",\"className\":\"bg-white rounded-xl p-4 text-center border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-2xl mb-1\",\"children\":\"🐟\"}],[\"$\",\"div\",null,{\"className\":\"text-sm font-semibold text-gray-700 group-hover:text-primary\",\"children\":\"Tilapia\"}]]}],[\"$\",\"$L3\",\"white-bellied-sea-eagle\",{\"href\":\"/animal/white-bellied-sea-eagle/\",\"className\":\"bg-white rounded-xl p-4 text-center border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-2xl mb-1\",\"children\":\"🦅\"}],[\"$\",\"div\",null,{\"className\":\"text-sm font-semibo