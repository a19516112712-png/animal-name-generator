 Related Articles\"}],[\"$\",\"div\",null,{\"className\":\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4\",\"children\":[[\"$\",\"$L9\",\"best-animal-names-by-habitat\",{\"href\":\"/blog/best-animal-names-by-habitat/\",\"className\":\"bg-white rounded-xl p-5 border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-3xl mb-3\",\"children\":\"🌍\"}],[\"$\",\"span\",null,{\"className\":\"text-xs bg-primary/10 text-primary font-semibold px-2 py-0.5 rounded-full\",\"children\":\"Naming Tips\"}],[\"$\",\"h3\",null,{\"className\":\"text-sm font-bold text-gray-800 mt-2 group-hover:text-primary line-clamp-2\",\"children\":\"Best Animal Names by Habitat: Forests, Oceans, Deserts & More 🌍\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-gray-500 mt-1 line-clamp-2\",\"children\":\"Discover the perfect animal names inspired by different habitats around the world. From deep ocean dwellers to desert survivors, find names rooted in nature's most beautiful landscapes.\"}]]}],[\"$\",\"$L9\",\"animal-names-inspired-by-art\",{\"href\":\"/blog/animal-names-inspired-by-art/\",\"className\":\"bg-white rounded-xl p-5 border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-3xl mb-3\",\"children\":\"🎨\"}],[\"$\",\"span\",null,{\"className\":\"text-xs bg-primary/10 text-primary font-semibold px-2 py-0.5 rounded-full\",\"children\":\"Naming Tips\"}],[\"$\",\"h3\",null,{\"className\":\"text-sm font-bold text-gray-800 mt-2 group-hover:text-primary line-clamp-2\",\"children\":\"Animal Names Inspired by Art: 150+ Creative Ideas 🎨\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-gray-500 mt-1 line-clamp-2\",\"children\":\"From famous painters to artistic techniques, find beautifully creative names for your masterpiece of a pet.\"}]]}],[\"$\",\"$L9\",\"pet-naming-psychology-choose-meaningful-name\",{\