ind mythical pet names that carry ancient meaning and storytelling magic.\"}]]}],[\"$\",\"$L3\",\"nature-inspired-pet-names-by-element\",{\"href\":\"/blog/nature-inspired-pet-names-by-element/\",\"className\":\"bg-white rounded-xl p-5 border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-3xl mb-3\",\"children\":\"🌿\"}],[\"$\",\"span\",null,{\"className\":\"text-xs bg-primary/10 text-primary font-semibold px-2 py-0.5 rounded-full\",\"children\":\"Creative Names\"}],[\"$\",\"h3\",null,{\"className\":\"text-sm font-bold text-gray-800 mt-2 group-hover:text-primary line-clamp-2\",\"children\":\"Nature-Inspired Pet Names by Element: Earth, Air, Fire & Water Names for Your Companion\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-gray-500 mt-1 line-clamp-2\",\"children\":\"Discover beautiful nature-inspired pet names organized by the four classical elements. From earthy forest names to fiery sun names, find the perfect elemental name for your pet.\"}]]}],\"$L45\",\"$L46\"]}]]}]\n41:[\"$\",\"nav\",null,{\"className\":\"mt-12 grid grid-cols-2 gap-4\",\"aria-label\":\"Post navigation\",\"children\":[[\"$\",\"$L3\",null,{\"href\":\"/blog/zodiac-astrology-pet-names-cosmic/\",\"className\":\"bg-white rounded-xl p-4 border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group text-left\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs text-gray-500\",\"children\":\"← Previous Post\"}],[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold text-gray-700 group-hover:text-primary mt-1 line-clamp-1\",\"children\":\"Zodiac and Astrology Pet Names: 130+ Celestial Ideas from the Stars\"}]]}],[\"$\",\"$L3\",null,{\"href\":\"/blog/male-cat-names-distinguished-strong/\",\"className\":\"bg-white rounded-xl p-4 border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group text-right\",\"children\":[[\"$\",\"span\"