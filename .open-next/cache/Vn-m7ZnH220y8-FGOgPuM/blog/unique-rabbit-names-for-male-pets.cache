ary/30 transition-all group\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-2xl mb-1\",\"children\":\"🐕\"}],[\"$\",\"div\",null,{\"className\":\"text-sm font-semibold text-gray-700 group-hover:text-primary\",\"children\":\"Chow Chow\"}]]}],[\"$\",\"$L9\",\"macaque\",{\"href\":\"/animal/macaque/\",\"className\":\"bg-white rounded-xl p-4 text-center border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-2xl mb-1\",\"children\":\"🐒\"}],[\"$\",\"div\",null,{\"className\":\"text-sm font-semibold text-gray-700 group-hover:text-primary\",\"children\":\"Macaque\"}]]}]]}]]}]\n26:[\"$\",\"section\",null,{\"className\":\"mt-12\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold mb-6\",\"children\":\"📖 Related Naming Guides\"}],[\"$\",\"div\",null,{\"className\":\"grid grid-cols-1 sm:grid-cols-2 gap-3\",\"children\":[[\"$\",\"$L9\",\"how-to-name-your-pig\",{\"href\":\"/guide/how-to-name-your-pig/\",\"className\":\"bg-white rounded-xl p-4 border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group flex items-center gap-3\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-2xl\",\"children\":\"📖\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold text-gray-700 group-hover:text-primary\",\"children\":\"How to Name Your Pig — Complete Guide 🐷\"}]]}],[\"$\",\"$L9\",\"how-to-name-your-parrot\",{\"href\":\"/guide/how-to-name-your-parrot/\",\"className\":\"bg-white rounded-xl p-4 border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group flex items-center gap-3\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-2xl\",\"children\":\"📖\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold text-gray-700 group-hover:text-primary\",\"children\":\"How to Name Your Parrot — Complete Guide 🦜\"}]]}],[\"$\",\"$L9\",\"classic-hamster-names\",{\"href\":\"/guide/classic-hamster-names/\",\"className\":\"bg-white rounded-xl p-4 border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group flex items-center gap-3\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-2xl\",\"children\":\"📖\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold text-gray-700 group-hover:text-primary\",\"children\":\"Classic Hamster Names — Top Classic Picks 🐹\"}]]}]]}]]}]\n27:[\"$\",\"section\",null,{\"className\":\"mt-12\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold mb-6\",\"children\":\"📝 Related Articles\"}],[\"$\",\"div\",null,{\"className\":\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4\",\"children\":[[\"$\",\"$L9\",\"bunny-names-by-personality-rabbit-guide\",{\"href\":\"/blog/bunny-names-by-personality-rabbit-guide/\",\"className\":\"bg-white rounded-xl p-5 border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-3xl mb-3\",\"children\":\"🐰\"}],[\"$\",\"span\",null,{\"className\":\"text-xs bg-primary/10 text-primary font-semibold px-2 py-0.5 rounded-full\",\"children\":\"Rabbit Names\"}],[\"$\",\"h3\",null,{\"className\":\"text-sm font-bold text-gray-800 mt-2 group-hover:text-primary line-clamp-2\",\"children\":\"Bunny Names by Personality: 130+ Rabbit Names Based on Character and Charm\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-gray-500 mt-1 line-clamp-2\",\"children\":\"130+ bunny names organized by personality type. From shy and gentle rabbits to bold and curious bunnies, find the perfect name matching your rabbit's unique character.\"}]]}],[\"$\",\"$L9\",\"the-ultimate-guide-to-playful-snowy-owl-names-175-ideas-for-every-snowy-owl-owner\",{\"href\":\"/blog/the-ultimate-guide-to-playful-snowy-owl-names-175-ideas-for-every-snowy-owl-owner/\",\"className\":\"bg-white rounded-xl p-5 border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-3xl mb-3\",\"children\":\"🐾\"}],[\"$\",\"span\",null,{\"className\":\"text-xs bg-primary/10 text-primary font-semibold px-2 py-0.5 rounded-full\",\"children\":\"Snowy Owl Names\"}],[\"$\",\"h3\",null,{\"className\":\"text-sm font-bold text-gray-800 mt-2 group-hover:text-primary line-clamp-2\",\"children\":\"The Ultimate Guide to Playful Snowy Owl Names: 175+ Ideas for Every Snowy Owl Owner\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-gray-500 mt-1 line-clamp-2\",\"children\":\"From inspired by music inspirations to classic favorites, discover 175+ playful snowy owl names that capture your snowy owl's unique personality.\"}]]}],[\"$\",\"$L9\",\"the-ultimate-guide-to-best-sulcata-tortoise-names-60-ideas-for-every-sulcata-tortoise-owner\",{\"href\":\"/blog/the-ultimate-guide-to-best-sulcata-tortoise-names-60-ideas-for-every-sulcata-tortoise-owner/\",\"className\":\"bg-white rounded-xl p-5 border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-3xl mb-3\",\"children\":\"🐱\"}],[\"$\",\"span\",null,{\"className\":\"text-xs bg-primary/10 text-primary font-semibold px-2 py-0.5 rounded-full\",\"children\":\"Sulcata Tortoise Names\"}],[\"$\",\"h3\",null,{\"className\":\"text-sm font-bold text-gray-800 mt-2 group-hover:text-primary line-clamp-2\",\"children\":\"The Ultimate Guide to Best Sulcata Tortoise Names: 60+ Ideas for Every Sulcata Tortoise Owner\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-gray-500 mt-1 line-clamp-2\",\"children\":\"From seasonal favorites inspirations to classic favorites, discover 60+ best sulcata tortoise names that capture your sulcata tortoise's unique personality.\"}]]}],[\"$\",\"$L9\",\"the-ultimate-guide-to-fluffy-tenrec-names-70-ideas-for-every-tenrec-owner\",{\"href\":\"/blog/the-ultimate-guide-to-fluffy-tenrec-names-70-ideas-for-every-tenrec-owner/\",\"className\":\"bg-white rounded-xl p-5 border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-3xl mb-3\",\"children\":\"🐾\"}],[\"$\",\"span\",null,{\"className\":\"text-xs bg-primary/10 text-primary font-semibold px-2 py-0.5 rounded-full\",\"children\":\"Tenrec Names\"}],[\"$\",\"h3\",null,{\"className\":\"text-sm font-bold text-gray-800 mt-2 group-hover:text-primary line-clamp-2\",\"children\":\"The Ultimate Guide to Fluffy Tenrec Names: 70+ Ideas for Every Tenrec Owner\"}],\"$L31\"]}],\"$L32\",\"$L33\"]}]]}]\n28:[\"$\",\"nav\",null,{\"className\":\"mt-12 grid grid-cols-2 gap-4\",\"aria-label\":\"Post navigation\",\"children\":[[\"$\",\"$L9\",null,{\"href\":\"/blog/horse-names-inspired-by-nature/\",\"className\":\"bg-white rounded-xl p-4 border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group text-left\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs text-gray-500\",\"children\":\"← Previous Post\"}],[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold text-gray-700 group-hover:text-primary mt-1 line-clamp-1\",\"children\":\"Horse Names Inspired By Nature: 80+ Beautiful Earth-Inspired Ideas\"}]]}],[\"$\",\"$L9\",null,{\"href\":\"/blog/best-dog-names-by-breed/\",\"className\":\"bg-white rounded-xl p-4 border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group text-right\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs text-gray-500\",\"children\":\"Next Post →\"}],[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold text-gray-700 group-hover:text-primary mt-1 line-clamp-1\",\"children\":\"Best Dog Names by Breed: From Chihuahua to Great Dane 🐕\"}]]}]]}]\n29:[\"$\",\"div\",null,{\"className\":\"mt-12 p-6 bg-primary/5 rounded-2xl border border-primary/10 text-center\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-lg font-semibold text-gray-800 mb-2\",\"children\":\"🐾 Ready to find the perfect animal name?\"}],[\"$\",\"p\",null,{\"className\":\"text-gray-600 mb-4\",\"children\":\"Browse our complete collection of 200+ animal name generators — all 100% free.\"}],[\"$\",\"$L9\",null,{\"href\":\"/animals/\",\"className\":\"inline-block bg-primary text-white font-bold px-6 py-3 rounded-full hover:bg-primary-dark transition-colors\",\"children\":\"Browse All Animals →\"}]]}]\n2c:null\n2d:[\"$\",\"details\",\"6\",{\"className\":\"bg-gray-50 rounded-xl p-5 group\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"font-semibold cursor-pointer group-open:text-primary\",\"children\":\"How do mythological names work for such a small, domestic pet?\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-gray-600 leading-relaxed\",\"children\":\"The contrast is the charm. A tiny Netherland Dwarf named after a mythological trickster god creates delightful narrative tension. These names give your rabbit a story and a personality that generic pet names cannot match.\"}]]}]\n2e:[\"$\",\"details\",\"7\",{\"className\":\"bg-gray-50 rounded-xl p-5 group\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"font-semibold cursor-pointer group-open:text-primary\",\"children\":\"Should rabbit names match their breed's country of origin?\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-gray-600 leading-relaxed\",\"children\":\"It is a lovely touch when it works. A Holland Lop with a Dutch name, a French Lop with a French name, or an English Spot with a classic English name creates cultural coherence. However, personality should always trump geography when the two conflict.\"}]]}]\n2f:[\"$\",\"details\",\"8\",{\"className\":\"bg-gray-50 rounded-xl p-5 group\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"font-semibold cursor-pointer group-open:text-primary\",\"children\":\"What should I avoid when naming a male rabbit?\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-gray-600 leading-relaxed\",\"children\":\"Avoid names that are hard to distinguish from common rabbit-care words or commands. Also avoid names that sound too similar to other pets in the household. Rabbits are sensitive to sound and can become confused if names overlap with words they hear frequently.\"}]]}]\n30:[\"$\",\"details\",\"9\",{\"className\":\"bg-gray-50 rounded-xl p-5 group\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"font-semibold cursor-pointer group-open:text-primary\",\"children\":\"Can two male rabbits share a themed pair of names?\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-gray-600 leading-relaxed\",\"children\":\"Themed pairs for bonded rabbits are genuinely delightful. Literary pairs like Hazel and Fiver, historical pairs like Lewis and Clark, or mythological pairs like Apollo and Hermes all create a cohesive identity for your rabbit duo. Just ensure each name is distinct enough for the rabbits to recognize individually.\"}]]}]\n31:[\"$\",\"p\",null,{\"className\":\"text-xs text-gray-500 mt-1 line-clamp-2\",\"children\":\"From inspired by sports inspirations to classic favorites, discover 70+ fluffy tenrec names that capture your tenrec's unique personality.\"}]\n32:[\"$\",\"$L9\",\"funny-macaque-names-inspired-by-music-60-funny-ideas-for-your-macaque\",{\"href\":\"/blog/funny-macaque-names-inspired-by-music-60-funny-ideas-for-your-macaque/\",\"className\":\"bg-white rounded-xl p-5 border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-3xl mb-3\",\"children\":\"🐾\"}],[\"$\",\"span\",null,{\"className\":\"text-xs bg-primary/10 text-primary font-semibold px-2 py-0.5 rounded-full\",\"children\":\"Macaque Names\"}],[\"$\",\"h3\",null,{\"className\":\"text-sm font-bold text-gray-800 mt-2 group-hover:text-primary line-clamp-2\",\"children\":\"Funny Macaque Names Inspired by Music: 60+ Funny Ideas for Your Macaque\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-gray-500 mt-1 line-clamp-2\",\"children\":\"Looking for funny 