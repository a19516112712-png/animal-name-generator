n\\\":[3,\\\".\\\"]}],[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#food\\\",\\\"className\\\":\\\"text-gray-700 hover:text-primary hover:underline transition-colors text-sm leading-relaxed\\\",\\\"children\\\":\\\"Food-Inspired Boy Bunny Names\\\"}]]}],[\\\"$\\\",\\\"li\\\",\\\"3\\\",{\\\"className\\\":\\\"flex items-start gap-2\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-primary font-bold mt-0.5 min-w-[1.5em]\\\",\\\"children\\\":[4,\\\".\\\"]}],[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#nature\\\",\\\"className\\\":\\\"text-gray-700 hover:text-primary hover:underline transition-colors text-sm leading-relaxed\\\",\\\"children\\\":\\\"Nature \\u0026 Woodland Names\\\"}]]}],[\\\"$\\\",\\\"li\\\",\\\"4\\\",{\\\"className\\\":\\\"flex items-start gap-2\\\",\\\"children\\\":[[\\\"$\\\",\\\"span\\\",null,{\\\"className\\\":\\\"text-primary font-bold mt-0.5 min-w-[1.5em]\\\",\\\"children\\\":[5,\\\".\\\"]}],[\\\"$\\\",\\\"a\\\",null,{\\\"href\\\":\\\"#pick\\\",\\\"className\\\":\\\"text-gray-700 hover:text-primary hover:underline transition-colors text-sm leading-relaxed\\\",\\\"children\\\":\\\"How to Pick the Perfect Name\\\"}]]}]]}]]}],\\\"$L23\\\",\\\"$L24\\\",\\\"$L25\\\",\\\"$L26\\\",\\\"$L27\\\",\\\"$L28\\\",\\\"$L29\\\",\\\"$L2a\\\",\\\"$L2b\\\",\\\"$L2c\\\",\\\"$L2d\\\",\\\"$L2e\\\",\\\"$L2f\\\",\\\"$L30\\\",\\\"$L31\\\",\\\"$L32\\\",\\\"$L33\\\",\\\"$L34\\\",\\\"$L35\\\",\\\"$L36\\\",\\\"$L37\\\",\\\"$L38\\\",\\\"$L39\\\",\\\"$L3a\\\",\\\"$L3b\\\",\\\"$L3c\\\"]}],\\\"$L3d\\\",\\\"$L3e\\\",\\\"$L3f\\\",\\\"$L40\\\",\\\"$L41\\\",\\\"$L42\\\"]}]\\n\"])</script><script>self.__next_f.push([1,\"23:[\\\"$\\\",\\\"h2\\\",\\\"2\\\",{\\\"className\\\":\\\"text-2xl font-bold mt-10 mb-4 text-gray-900\\\",\\\"children\\\":[\\\"Why Male Rabbits Deserve Unique Names\\\"]}]\\n24:[\\\"$\\\",\\\"p\\\",\\\"3\\\",{\\\"className\\\":\\\"text-gray-700 leading-relaxed mb-4\\\",\\\"children\\\":[\\\"Male rabbits — bucks — have distinct personalities that set them apart from other pets. They are curious, social, and surprisingly expressive creatures who communicate through ear positions, body language, and a fascinating range of vocalizations from purring to grunting. Unique rabbit names for male pets should reflect these special qualities rather than defaulting to generic small pet names. A rabbit named Thumper or Bugs is perfectly fine, but a rabbit named Atticus or Truffle tells a richer story about who your bunny actually is.\\\"]}]\\n25:[\\\"$\\\",\\\"p\\\",\\\"4\\\",{\\\"className\\\":\\\"text-gray-700 leading-relaxed mb-4\\\",\\\"children\\\":[\\\"Rabbits are the third most popular pet in America after dogs and cats, with approximately 2.2 million pet rabbits in US households according to the American Pet Products Association. Despite this popularity, rabbit-specific naming resources remain surprisingly limited. Most small pet name lists lump rabbits together with hamsters, gerbils, and guinea pigs without acknowledging the distinct personality, intelligence, and social nature of rabbits. This guide fills that gap with 80+ names specifically chosen for male rabbits based on personality type, appearance, and the unique bond between rabbits and their owners.\\\"]}]\\n26:[\\\"$\\\",\\\"h2\\\",\\\"5\\\",{\\\"className\\\":\\\"text-2xl font-bold mt-10 mb-4 text-gray-900\\\",\\\"children\\\":[\\\"Classic Gentleman Names for Male Rabbits\\\"]}]\\n27:[\\\"$\\\",\\\"p\\\",\\\"6\\\",{\\\"className\\\":\\\"text-gray-700 leading-relaxed mb-4\\\",\\\"children\\\":[\\\"There is something deeply charming about giving a dignified, gentlemanly name to a small, fluffy rabbit. The contrast between formal name and adorable animal creates instant warmth and memorability. Atticus, from To Kill a Mockingbird, suits a wise, calm rabbit who observes the world with quiet intelligence. Theodore, with its built-in nickname Teddy, works for especially cuddly bunnies. Sebastian suggests sophistication and refinement perfect for the rabbit who grooms himself with particular fastidiousness.\\\"]}]\\n28:[\\\"$\\\",\\\"p\\\",\\\"7\\\",{\\\"className\\\":\\\"text-gray-700 leading-relaxed mb-4\\\",\\\"children\\\":[\\\"More classic gentleman names: Winston carries British dignity. Oliver is friendly and approachable. Jasper has a vintage charm that feels both distinguished and playful. Felix means happy or fortunate in Latin — fitting for a rescue rabbit who found a loving home. Hugo suggests literary sophistication. Barnaby feels whimsical and old-fashioned in the best way. Each of these names gives your male rabbit a presence that acknowledges his importance in your household rather than treating him as a minor pet.\\\"]}]\\n29:[\\\"$\\\",\\\"h2\\\",\\\"8\\\",{\\\"className\\\":\\\"text-2xl font-bold mt-10 mb-4 text-gray-900\\\",\\\"children\\\":[\\\"Food-Inspired Boy Bunny Names\\\"]}]\\n2a:[\\\"$\\\",\\\"p\\\",\\\"9\\\",{\\\"className\\\":\\\"text-gray-700 leading-relaxed mb-4\\\",\\\"children\\\":[\\\"Rabbits are famously food-motivated creatures, and naming your male rabbit after something delicious is both accurate and adorable. Food names for rabbits have the added benefit of naturally suiting their round, soft bodies and their genuine enthusiasm for mealtime. Truffle suggests something rare, precious, and utterly delightful — much like your rabbit. Mochi captures that soft, squishy, sweet quality that makes rabbits so huggable. Biscuit is warm, comforting, and universally beloved.\\\"]}]\\n2b:[\\\"$\\\",\\\"p\\\",\\\"10\\\",{\\\"className\\\":\\\"text-gray-700 leading-relaxed mb-4\\\",\\\"children\\\":[\\\"Beyond the obvious choices, consider cuisine-specific food names that tell a story. Pesto suggests herbal freshness and Italian warmth. Kimchi adds Korean spice and personality. Wasabi packs surprising heat into a small package — perfect for a tiny rabbit with a big attitude. Chai brings aromatic complexity. Tofu describes a white rabbit's coloring while being genuinely cute. Nori suits darker-colored rabbits. Each of these names rewards cultural knowledge while remaining accessible and memorable.\\\"]}]\\n2c:[\\\"$\\\",\\\"h2\\\",\\\"11\\\",{\"])</script><script>self.__next_f.push([1,\"\\\"className\\\":\\\"text-2xl font-bold mt-10 mb-4 text-gray-900\\\",\\\"children\\\":[\\\"Nature \\u0026 Woodland Names for Male Rabbits\\\"]}]\\n2d:[\\\"$\\\",\\\"p\\\",\\\"12\\\",{\\\"className\\\":\\\"text-gray-700 leading-relaxed mb-4\\\",\\\"children\\\":[\\\"Rabbits are creatures of meadows, forests, and fields, making nature-inspired names a natural and beautiful fit. Woodland names connect your domestic rabbit to their wild cousins — the cottontails, hares, and European rabbits that inspired countless folktales and children's stories. Thistle evokes quiet meadows and gentle breezes. Clover connects to the rabbit's favorite treat and symbolizes good fortune. Bracken suggests the dappled forest floor where wild rabbits make their homes.\\\"]}]\\n2e:[\\\"$\\\",\\\"p\\\",\\\"13\\\",{\\\"className\\\":\\\"text-gray-700 leading-relaxed mb-4\\\",\\\"children\\\":[\\\"Forest-inspired names: Cedar, Oak, Birch, and Rowan all carry the strength and steadfastness of trees while remaining gentle enough for a small animal. Meadow and Glen paint pastoral landscapes in a single word. River suggests movement, life, and natural beauty. These names bring a touch of the wild into your home while honoring your rabbit's evolutionary heritage and natural instincts.\\\"]}]\\n2f:[\\\"$\\\",\\\"h2\\\",\\\"14\\\",{\\\"className\\\":\\\"text-2xl font-bold mt-10 mb-4 text-gray-900\\\",\\\"children\\\":[\\\"How to Pick the Perfect Male Rabbit Name\\\"]}]\\n30:[\\\"$\\\",\\\"p\\\",\\\"15\\\",{\\\"className\\\":\\\"text-gray-700 leading-relaxed mb-4\\\",\\\"children\\\":[\\\"Observing your rabbit for a few days before deciding on a name is genuinely worth the patience. Male rabbits reveal their personalities through consistent patterns: some are bold explorers who investigate every corner, others are cautious observers who prefer to watch from a safe distance. Some demand attention through gentle nose nudges, while others express affection through quiet proximity. The right name will naturally emerge from watching who your rabbit actually is rather than who you expected them to be.\\\"]}]\\n31:[\\\"$\\\",\\\"p\\\",\\\"16\\\",{\\\"className\\\":\\\"text-gray-700 leading-relaxed mb-4\\\",\\\"children\\\":[\\\"Practical considerations matter too. Short names with clear consonant sounds are easier for rabbits to recognize — they may not come when called like dogs, but rabbits absolutely learn to associate specific sounds with food, attention, and positive experiences. Test your top choices by saying them during treat time for a few days each. The name that feels most natural when you say it, paired with a happy rabbit who associates it with good things, is almost certainly the winner.\\\"]}]\\n32:[\\\"$\\\",\\\"h2\\\",\\\"17\\\",{\\\"className\\\":\\\"text-2xl font-bold mt-10 mb-4 text-gray-900\\\",\\\"children\\\":[\\\"Literary \\u0026 Historical Male Rabbit Names\\\"]}]\\n33:[\\\"$\\\",\\\"p\\\",\\\"18\\\",{\\\"className\\\":\\\"text-gray-700 leading-relaxed mb-4\\\",\\\"children\\\":[\\\"Literature and history offer a rich vein of distinguished names for male rabbits. Peter, from Beatrix Potter's beloved tales, is so iconic that it has become nearly synonymous with rabbits themselves. But beyond Peter, Potter's world provides Benjamin, the loyal cousin, and Mr. McGregor's garden-raiding crew of Flopsy, Mopsy, and Cottontail — though those skew feminine, their charm is undeniable for any rabbit.\\\"]}]\\n34:[\\\"$\\\",\\\"p\\\",\\\"19\\\",{\\\"className\\\":\\\"text-gray-700 leading-relaxed mb-4\\\",\\\"children\\\":[\\\"From broader literature: Hazel and Fiver from Watership Down are perhaps the most dignified rabbit names in all of fiction. Hazel, the thoughtful leader, and Fiver, the anxious prophet, give your rabbit literary gravitas. From history: Napoleon suits a particularly ambitious, determined rabbit who conquers every obstacle course and treat puzzle you set before him. Aristotle works for the contemplative rabbit who seems to study the world with philosophical depth. These names elevate your rabbit from pet to personality with genuine cultural weight.\\\"]}]\\n35:[\\\"$\\\",\\\"h2\\\",\\\"20\\\",{\\\"className\\\":\\\"text-2xl font-bold mt-10 mb-4 text-gray-900\\\",\\\"children\\\":[\\\"Mythology-Inspired Male Rabbit Names\\\"]}]\\n36:[\\\"$\\\",\\\"p\\\",\\\"21\\\",{\\\"className\\\":\\\"text-gray-700 leading-relaxed mb-4\\\",\\\"children\\\":[\\\"Rabbits appear frequently in world mythology, often as clever tricksters, moon-dwelling companions, or symbols of fertility and renewal. The Moo\"])</script><script>self.__next_f.push([1,\"n Rabbit appears across Chinese, Japanese, and Korean folklore — a rabbit who lives on the moon, pounding the elixir of life. Names drawn from lunar mythology — Tsuki (Japanese for moon), Selene (Greek moon goddess, adaptable for males), or simply Moon — connect your rabbit to these ancient and beautiful stories.\\\"]}]\\n37:[\\\"$\\\",\\\"p\\\",\\\"22\\\",{\\\"className\\\":\\\"text-gray-700 leading-relaxed mb-4\\\",\\\"children\\\":[\\\"Trickster rabbits appear in African and Native American folklore. Br'er Rabbit from African American folktales is clever, resourceful, and always one step ahead of larger predators. Nanabozho from Ojibwe tradition is a shapeshifting rabbit spirit. Kokopelli, while typically depicted as a flute-playing figure, is associated with fertility and renewal — fitting for the famously reproductive rabbit. These mythological names give your rabbit a connection to centuries of storytelling tradition.\\\"]}]\\n38:[\\\"$\\\",\\\"h2\\\",\\\"23\\\",{\\\"className\\\":\\\"text-2xl font-bold mt-10 mb-4 text-gray-900\\\",\\\"children\\\":[\\\"Caring for Your Named Rabbit: Tips for New Owners\\\"]}]\\n39:[\\\"$\\\",\\\"p\\\",\\\"24\\\",{\\\"className\\\":\\\"text-gray-700 leading-relaxed mb-4\\\",\\\"children\\\":[\\\"Once you have chosen the perfect unique name for your male rabbit, the real work of rabbit care begins. Rabbits are social, intelligent animals who thrive on routine, enrichment, and gentle handling. Spend at least two hours of supervised out-of-cage time with your rabbit daily. Use their name consistently during feeding, play, and cuddle sessions — rabbits absolutely learn to associate their names with positive experiences, and consistent usage strengthens that bond enormously over time.\\\"]}]\\n3a:[\\\"$\\\",\\\"p\\\",\\\"25\\\",{\\\"className\\\":\\\"text-gray-700 leading-relaxed mb-4\\\",\\\"children\\\":[\\\"Male rabbits, especially once neutered, are often more affectionate and people-oriented than females. They tend to be more relaxed about handling and more eager for human interaction. This makes the naming process even more rewarding — your rabbit will genuinely learn to recognize and respond to the name you choose. For the best results, pair the name with a specific tone of voice and a small healthy treat like a tiny piece of banana or apple. Within weeks, your uniquely named boy bunny will come hopping when called, cementing the bond between name and animal in the most satisfying possible way.\\\"]}]\\n3b:[\\\"$\\\",\\\"p\\\",\\\"26\\\",{\\\"className\\\":\\\"text-gray-700 leading-relaxed mb-4\\\",\\\"children\\\":[\\\"Explore our name generators for \\\",[\\\"$\\\",\\\"$L3\\\",\\\"32\\\",{\\\"href\\\":\\\"/animal/anatolian-leopard/\\\",\\\"className\\\":\\\"text-primary font-semibold hover:underline\\\",\\\"children\\\":[\\\"Anatolian Leopard\\\",\\\" Name Generator\\\"]}],\\\", \\\",[\\\"$\\\",\\\"$L3\\\",\\\"53\\\",{\\\"href\\\":\\\"/animal/antechinus/\\\",\\\"className\\\":\\\"text-primary font-semibold hover:underline\\\",\\\"children\\\":[\\\"Antechinus\\\",\\\" Name Generator\\\"]}],\\\", \\\",[\\\"$\\\",\\\"$L3\\\",\\\"67\\\",{\\\"href\\\":\\\"/animal/american-black-bear/\\\",\\\"className\\\":\\\"text-primary font-semibold hover:underline\\\",\\\"children\\\":[\\\"American Black Bear\\\",\\\" Name Generator\\\"]}],\\\", \\\",[\\\"$\\\",\\\"$L3\\\",\\\"90\\\",{\\\"href\\\":\\\"/animal/aldabra-giant-tortoise/\\\",\\\"className\\\":\\\"text-primary font-semibold hover:underline\\\",\\\"children\\\":[\\\"Aldabra Giant Tortoise\\\",\\\" Name Generator\\\"]}],\\\", and \\\",[\\\"$\\\",\\\"$L3\\\",\\\"120\\\",{\\\"href\\\":\\\"/animal/alligator-gar/\\\",\\\"className\\\":\\\"text-primary font-semibold hover:underline\\\",\\\"children\\\":[\\\"Alligator Gar\\\",\\\" Name Generator\\\"]}],\\\" to find the perfect name for your companion.\\\"]}]\\n3c:[\\\"$\\\",\\\"p\\\",\\\"27\\\",{\\\"className\\\":\\\"text-gray-700 leading-relaxed mb-4\\\",\\\"children\\\":[\\\"Whether you are naming a new pet today or just exploring ideas for the future, the most important principle remains the same: the best name is the one that feels right to you and fits your specific animal. Take your time, involve your family in the process, and trust that the perfect name will reveal itself through patience and attention. Every great pet deserves a great name — and every great name starts with a thoughtful owner who cares enough to get it right. For thousands more name ideas across hundreds of animal species, browse our complete collection at bestanimalnames.com, where every name is hand-picked and every generator is 100 percent free.\\\"]}]\\n\"])</script><script>self.__next_f.push([1,\"3d:[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"mt-12 bg-white rounded-2xl p-6 border border-gray-100\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl font-bold mb-6\\\",\\\"children\\\":\\\"❓ Frequently Asked Questions\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"space-y-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"details\\\",\\\"0\\\",{\\\"className\\\":\\\"bg-gray-50 rounded-xl p-5 group\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"className\\\":\\\"font-semibold cursor-pointer group-open:text-primary\\\",\\\"children\\\":\\\"Do rabbits actually recognize their names?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-3 text-gray-600 leading-relaxed\\\",\\\"children\\\":\\\"Yes, rabbits can learn to recognize their names, especially when associated with positive reinforcement like treats and gentle petting. While they do not come when called as reliably as dogs, many rabbits clearly respond to their names through ear movement, head turning, or approaching their owners when called.\\\"}]]}],[\\\"$\\\",\\\"details\\\",\\\"1\\\",{\\\"className\\\":\\\"bg-gray-50 rounded-xl p-5 group\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"className\\\":\\\"font-semibold cursor-pointer group-open:text-primary\\\",\\\"children\\\":\\\"Should I name my rabbit based on its color or personality?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-3 text-gray-600 leading-relaxed\\\",\\\"children\\\":\\\"Both approaches work well. Color-based names like Snowball or Cocoa are intuitive and descriptive. Personality-based names like Rascal or Snuggles feel more personal and unique. Many owners combine both approaches — observing their rabbit's coloring and personality for a few days before deciding.\\\"}]]}],[\\\"$\\\",\\\"details\\\",\\\"2\\\",{\\\"className\\\":\\\"bg-gray-50 rounded-xl p-5 group\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"className\\\":\\\"font-semibold cursor-pointer group-open:text-primary\\\",\\\"children\\\":\\\"How long should a rabbit's name be?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-3 text-gray-600 leading-relaxed\\\",\\\"children\\\":\\\"One to two syllables is ideal for recognition and daily use. Names like Thumper, Clover, Mochi, and Theo are easy to say and for rabbits to distinguish. Longer names will naturally be shortened in daily use — maximize the odds that the shortened version is still a name you love.\\\"}]]}],[\\\"$\\\",\\\"details\\\",\\\"3\\\",{\\\"className\\\":\\\"bg-gray-50 rounded-xl p-5 group\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"className\\\":\\\"font-semibold cursor-pointer group-open:text-primary\\\",\\\"children\\\":\\\"Can two male rabbits live together with different names?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-3 text-gray-600 leading-relaxed\\\",\\\"children\\\":\\\"Male rabbits can live together successfully when both are neutered and properly bonded. Choose names with distinctly different sounds to help your rabbits identify which name applies to whom. Avoid rhyming pairs that create confusion during feeding and interaction.\\\"}]]}],[\\\"$\\\",\\\"details\\\",\\\"4\\\",{\\\"className\\\":\\\"bg-gray-50 rounded-xl p-5 group\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"className\\\":\\\"font-semibold cursor-pointer group-open:text-primary\\\",\\\"children\\\":\\\"What are the most popular male rabbit names?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-3 text-gray-600 leading-relaxed\\\",\\\"children\\\":\\\"Thumper remains the most popular by far, followed by Bugs, Peter (from Peter Rabbit), Oreo, and Snowball. Unique names like Truffle, Atticus, Mochi, and Clover are rapidly growing in popularity as rabbit owners seek more distinctive options.\\\"}]]}],[\\\"$\\\",\\\"details\\\",\\\"5\\\",{\\\"className\\\":\\\"bg-gray-50 rounded-xl p-5 group\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"className\\\":\\\"font-semibold cursor-pointer group-open:text-primary\\\",\\\"children\\\":\\\"Can I use a female literary character name for my male rabbit?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-3 text-gray-600 leading-relaxed\\\",\\\"children\\\":\\\"Absolutely. Literary names transcend gender, and rabbits certainly do not care about the gender of their namesakes. A male rabbit named Hazel (from Watership Down, where Hazel is male) or even literary names typically coded female can work beautifully if they suit your rabbit's personality.\\\"}]]}],\\\"$L43\\\",\\\"$L44\\\",\\\"$L45\\\",\\\"$L46\\\"]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"3e:[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"mt-12\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl font-bold mb-6\\\",\\\"children\\\":\\\"🐾 Related Animal Name Generators\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L3\\\",\\\"ostrich\\\",{\\\"href\\\":\\\"/animal/ostrich/\\\",\\\"className\\\":\\\"bg-white rounded-xl p-4 text-center border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"text-2xl mb-1\\\",\\\"children\\\":\\\"🦤\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"text-sm font-semibold text-gray-700 group-hover:text-primary\\\",\\\"children\\\":\\\"Ostrich\\\"}]]}],[\\\"$\\\",\\\"$L3\\\",\\\"suphalak\\\",{\\\"href\\\":\\\"/animal/suphalak/\\\",\\\"className\\\":\\\"bg-white rounded-xl p-4 text-center border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"text-2xl mb-1\\\",\\\"children\\\":\\\"🐱\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"text-sm font-semibold text-gray-700 group-hover:text-primary\\\",\\\"children\\\":\\\"Suphalak\\\"}]]}],[\\\"$\\\",\\\"$L3\\\",\\\"vulture\\\",{\\\"href\\\":\\\"/animal/vulture/\\\",\\\"className\\\":\\\"bg-white rounded-xl p-4 text-center border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"text-2xl mb-1\\\",\\\"children\\\":\\\"🦅\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"text-sm font-semibold text-gray-700 group-hover:text-primary\\\",\\\"children\\\":\\\"Vulture\\\"}]]}],[\\\"$\\\",\\\"$L3\\\",\\\"greyhound\\\",{\\\"href\\\":\\\"/animal/greyhound/\\\",\\\"className\\\":\\\"bg-white rounded-xl p-4 text-center border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"text-2xl mb-1\\\",\\\"children\\\":\\\"🐕\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"text-sm font-semibold text-gray-700 group-hover:text-primary\\\",\\\"children\\\":\\\"Greyhound\\\"}]]}],[\\\"$\\\",\\\"$L3\\\",\\\"great-horned-owl\\\",{\\\"href\\\":\\\"/animal/great-horned-owl/\\\",\\\"className\\\":\\\"bg-white rounded-xl p-4 text-center border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"text-2xl mb-1\\\",\\\"children\\\":\\\"🦉\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"text-sm font-semibold text-gray-700 group-hover:text-primary\\\",\\\"children\\\":\\\"Great Horned Owl\\\"}]]}],[\\\"$\\\",\\\"$L3\\\",\\\"gerenuk\\\",{\\\"href\\\":\\\"/animal/gerenuk/\\\",\\\"className\\\":\\\"bg-white rounded-xl p-4 text-center border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"text-2xl mb-1\\\",\\\"children\\\":\\\"🦌\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"text-sm font-semibold text-gray-700 group-hover:text-primary\\\",\\\"children\\\":\\\"Gerenuk\\\"}]]}],[\\\"$\\\",\\\"$L3\\\",\\\"chow-chow\\\",{\\\"href\\\":\\\"/animal/chow-chow/\\\",\\\"className\\\":\\\"bg-white rounded-xl p-4 text-center border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"text-2xl mb-1\\\",\\\"children\\\":\\\"🐕\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"text-sm