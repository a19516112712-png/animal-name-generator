,\"children\":\"Classic Bird Names — Top Classic Picks 🐦\"}]]}],[\"$\",\"$L3\",\"how-to-name-your-chicken\",{\"href\":\"/guide/how-to-name-your-chicken/\",\"className\":\"bg-white rounded-xl p-4 border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group flex items-center gap-3\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-2xl\",\"children\":\"📖\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold text-gray-700 group-hover:text-primary\",\"children\":\"How to Name Your Chicken — Complete Guide 🐔\"}]]}]]}]]}]\n40:[\"$\",\"section\",null,{\"className\":\"mt-12\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold mb-6\",\"children\":\"📝 Related Articles\"}],[\"$\",\"div\",null,{\"className\":\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4\",\"children\":[[\"$\",\"$L3\",\"exotic-pet-names-complete-guide\",{\"href\":\"/blog/exotic-pet-names-complete-guide/\",\"className\":\"bg-white rounded-xl p-5 border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-3xl mb-3\",\"children\":\"🦎\"}],[\"$\",\"span\",null,{\"className\":\"text-xs bg-primary/10 text-primary font-semibold px-2 py-0.5 rounded-full\",\"children\":\"Pet Names\"}],[\"$\",\"h3\",null,{\"className\":\"text-sm font-bold text-gray-800 mt-2 group-hover:text-primary line-clamp-2\",\"children\":\"Exotic Pet Names: The Complete Guide for Unusual Animals 🦎\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-gray-500 mt-1 line-clamp-2\",\"children\":\"Naming an exotic pet requires special consideration. From reptiles and amphibians to birds and small mammals, discover 150+ names perfect for bearded dragons, snakes, parrots, hedgehogs, and all unusual companions.\"}]]}],[\"$\",\"$L3\",\"first-week-pet-naming-guide\",{\"href\":\"/blog/first-week-pet-naming-guide/\",\"className\":\"bg-white rounded-xl p-5 border border-gray-100 shadow-sm hover:shad