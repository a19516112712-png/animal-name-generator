",\"children\":[[\"$\",\"summary\",null,{\"className\":\"font-semibold cursor-pointer group-open:text-primary\",\"children\":\"Should pet names match pet insurance registration?\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-gray-600 leading-relaxed\",\"children\":\"Use the same name consistently across vet records, microchips, and insurance. In an emergency, a consistent name helps veterinary staff quickly identify and treat your pet.\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"bg-gray-50 rounded-xl p-5 group\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"font-semibold cursor-pointer group-open:text-primary\",\"children\":\"What if I change my pet's name after adoption?\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-gray-600 leading-relaxed\",\"children\":\"Adult pets can learn new names with patience. Use lots of treats and positive reinforcement. Most pets adjust within a few weeks. Consistency is key.\"}]]}]]}]]}]\n68:[\"$\",\"section\",null,{\"className\":\"mt-12\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold mb-6\",\"children\":\"🐾 Related Animal Name Generators\"}],[\"$\",\"div\",null,{\"className\":\"grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3\",\"children\":[[\"$\",\"$L9\",\"goldfish\",{\"href\":\"/animal/goldfish/\",\"className\":\"bg-white rounded-xl p-4 text-center border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-2xl mb-1\",\"children\":\"🐠\"}],[\"$\",\"div\",null,{\"className\":\"text-sm font-semibold text-gray-700 group-hover:text-primary\",\"children\":\"Goldfish\"}]]}],[\"$\",\"$L9\",\"ethiopian-wolf\",{\"href\":\"/animal/ethiopian-wolf/\",\"className\":\"bg-white rounded-xl p-4 text-center border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-2xl mb-1\",\"children\":\"🐺\"}],[\"$\",\"div\",null,{\"clas