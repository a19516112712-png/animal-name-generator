-xs bg-gray-100 text-gray-600 px-3 py-1 rounded-full\",\"children\":\"shakespeare pet names\"}],[\"$\",\"span\",\"fictional animal names\",{\"className\":\"text-xs bg-gray-100 text-gray-600 px-3 py-1 rounded-full\",\"children\":\"fictional animal names\"}],[\"$\",\"span\",\"literary cat names\",{\"className\":\"text-xs bg-gray-100 text-gray-600 px-3 py-1 rounded-full\",\"children\":\"literary cat names\"}],[\"$\",\"span\",\"literary dog names\",{\"className\":\"text-xs bg-gray-100 text-gray-600 px-3 py-1 rounded-full\",\"children\":\"literary dog names\"}]]}]]}],[\"$\",\"div\",null,{\"className\":\"prose prose-lg max-w-none\",\"children\":[[\"$\",\"h2\",\"0\",{\"className\":\"text-2xl font-bold mt-10 mb-4 text-gray-900\",\"children\":[\"📋 Table of Contents\"]}],[\"$\",\"div\",\"1\",{\"className\":\"bg-gradient-to-br from-primary/5 to-indigo-50 rounded-2xl p-6 border border-primary/10 mb-8\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-lg font-bold text-gray-800 mb-4\",\"children\":\"📋 Table of Contents\"}],[\"$\",\"ol\",null,{\"className\":\"space-y-2 list-none pl-0\",\"children\":[[\"$\",\"li\",\"0\",{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-primary font-bold mt-0.5 min-w-[1.5em]\",\"children\":[1,\".\"]}],[\"$\",\"a\",null,{\"href\":\"#why-literary\",\"className\":\"text-gray-700 hover:text-primary hover:underline transition-colors text-sm leading-relaxed\",\"children\":\"Why Literary Names Make Meaningful Pet Names\"}]]}],[\"$\",\"li\",\"1\",{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-primary font-bold mt-0.5 min-w-[1.5em]\",\"children\":[2,\".\"]}],[\"$\",\"a\",null,{\"href\":\"#shakespeare\",\"className\":\"text-gray-700 hover:text-primary hover:underline transition-colors text-sm leading-relaxed\",\"children\":\"Shakespeare-Inspired Pet Names\"}]]}],[\"$\",\"li\",\"2\",{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-primary font-bold mt-0.5 min-w-[1.5em]\",\"children\":[3,\".\"]}],[\"$\",\"a\",null,{\"href\":\"#classic\",\"className\":\"text-gray-700 hover:text-primary hover:underline transition-colors text-sm leading-relaxed\",\"children\":\"Classic Literature Pet Names\"}]]}],[\"$\",\"li\",\"3\",{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-primary font-bold mt-0.5 min-w-[1.5em]\",\"children\":[4,\".\"]}],[\"$\",\"a\",null,{\"href\":\"#fantasy-lit\",\"className\":\"text-gray-700 hover:text-primary hover:underline transition-colors text-sm leading-relaxed\",\"children\":\"Fantasy Literature Names\"}]]}],[\"$\",\"li\",\"4\",{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-primary font-bold mt-0.5 min-w-[1.5em]\",\"children\":[5,\".\"]}],\"$L23\"]}],\"$L24\",\"$L25\",\"$L26\"]}]]}],\"$L27\",\"$L28\",\"$L29\",\"$L2a\",\"$L2b\",\"$L2c\",\"$L2d\",\"$L2e\",\"$L2f\",\"$L30\",\"$L31\",\"$L32\",\"$L33\",\"$L34\",\"$L35\",\"$L36\",\"$L37\",\"$L38\",\"$L39\",\"$L3a\",\"$L3b\",\"$L3c\",\"$L3d\",\"$L3e\",\"$L3f\"]}],\"$L40\",\"$L41\",\"$L42\",\"$L43\",\"$L44\",\"$L45\"]}]\n23:[\"$\",\"a\",null,{\"href\":\"#children\",\"className\":\"text-gray-700 hover:text-primary hover:underline transition-colors text-sm leading-relaxed\",\"children\":\"Children's Literature Names\"}]\n24:[\"$\",\"li\",\"5\",{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-primary font-bold mt-0.5 min-w-[1.5em]\",\"children\":[6,\".\"]}],[\"$\",\"a\",null,{\"href\":\"#modern\",\"className\":\"text-gray-700 hover:text-primary hover:underline transition-colors text-sm leading-relaxed\",\"children\":\"Modern Literary Pet Names\"}]]}]\n25:[\"$\",\"li\",\"6\",{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-primary font-bold mt-0.5 min-w-[1.5em]\",\"children\":[7,\".\"]}],[\"$\",\"a\",null,{\"href\":\"#famous-animals\",\"className\":\"text-gray-700 hover:text-primary hover:underline transition-colors text-sm leading-relaxed\",\"children\":\"Famous Animal Characters in Literature\"}]]}]\n26:[\"$\",\"li\",\"7\",{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-primary font-bold mt-0.5 min-w-[1.5em]\",\"children\":[8,\".\"]}],[\"$\",\"a\",null,{\"href\":\"#faq\",\"className\":\"text-gray-700 hover:text-primary hover:underline transition-colors text-sm leading-relaxed\",\"children\":\"Frequently Asked Questions\"}]]}]\n27:[\"$\",\"h2\",\"2\",{\"className\":\"text-2xl font-bold mt-10 mb-4 text-gray-900\",\"children\":[\"Why Literary Names Make Meaningful Pet Names\"]}]\n28:[\"$\",\"p\",\"3\",{\"className\":\"text-gray-700 leading-relaxed mb-4\",\"children\":[\"Naming your pet after a literary character is one of the most personal and meaningful choices you can make. Unlike trendy names that come and go, literary names carry the weight of stories that have moved generations. When you name your dog Atticus, your cat Hermione, or your rabbit Bilbo, you are not just giving them a name — you are connecting them to the values, adventures, and emotions of beloved books. Every time you call their name, you are reminded of the stories that shaped you.\"]}]\n29:[\"$\",\"p\",\"4\",{\"className\":\"text-gray-700 leading-relaxed mb-4\",\"children\":[\"Literary names also make wonderful conversation starters. At the dog park, 'This is Darcy' is likely to earn a knowing smile from fellow Jane Austen fans. At the vet's office, 'Gatsby' might spark a discussion about the American Dream. These names carry cultural currency and personal significance in equal measure. For book lovers, there is no more fitting tribute to a beloved companion than a name drawn from the pages that have meant the most.\"]}]\n2a:[\"$\",\"p\",\"5\",{\"className\":\"text-gray-700 leading-relaxed mb-4\",\"children\":[\"BestAnimalNames.com has curated this collection of literary animal names spanning Shakespeare to contemporary bestsellers. Whether you favor classic novels, epic fantasy, heartwarming children's stories, or modern literary fiction, you will find names here that speak to your reader's heart and suit your animal friend perfectly.\"]}]\n2b:[\"$\",\"h2\",\"6\",{\"className\":\"text-2xl font-bold mt-10 mb-4 text-gray-900\",\"children\":[\"Shakespeare-Inspired Pet Names\"]}]\n2c:[\"$\",\"p\",\"7\",{\"className\":\"text-gray-700 leading-relaxed mb-4\",\"children\":[\"Shakespeare created some of the most memorable characters in literary history. Their names carry dramatic weight and timeless appeal:\"]}]\n2d:[\"$\",\"p\",\"8\",{\"className\":\"text-gray-700 leading-relaxed mb-4\",\"dangerouslySetInnerHTML\":{\"__html\":\"<strong>Romeo</strong> — The romantic hero, perfect for an affectionate pet. <strong>Juliet</strong> — Graceful and devoted. <strong>Hamlet</strong> — Thoughtful, perhaps a bit dramatic. <strong>Ophelia</strong> — Beautiful and tragic, for ethereal pets. <strong>Oberon</strong> — King of the fairies, majestic. <strong>Titania</strong> — Queen of the fairies, regal. <strong>Puck</strong> — Mischievous and playful — perfect for spirited pets. <strong>Portia</strong> — Intelligent and eloquent. <strong>Othello</strong> — Strong and noble. <strong>Desdemona</strong> — Loyal and pure-hearted. <strong>Prospero</strong> — Wise and powerful. <strong>Miranda</strong> — Wonder and beauty. <strong>Iago</strong> — For a clever, perhaps manipulative pet. <strong>Cordelia</strong> — Faithful and true. <strong>Macbeth</strong> — Ambitious and bold (Mac for short).\"}}]\n2e:[\"$\",\"h2\",\"9\",{\"className\":\"text-2xl font-bold mt-10 mb-4 text-gray-900\",\"children\":[\"Classic Literature Pet Names\"]}]\n2f:[\"$\",\"p\",\"10\",{\"className\":\"text-gray-700 leading-relaxed mb-4\",\"children\":[\"The great novels of the 19th and early 20th centuries offer names of substance and character:\"]}]\n30:[\"$\",\"p\",\"11\",{\"className\":\"text-gray-700 leading-relaxed mb-4\",\"dangerouslySetInnerHTML\":{\"__html\":\"<strong>Darcy</strong> — Mr. Darcy from Pride and Prejudice. Proud but deeply loyal. <strong>Elizabeth</strong> — Lizzie Bennet, witty and independent. <strong>Heathcliff</strong> — From Wuthering Heights. Passionate and intense. <strong>Catherine</strong> — Also from Wuthering Heights. <strong>Gatsby</strong> — The Great Gatsby. Mysterious and hopeful. <strong>Daisy</strong> — Also from Gatsby. Beautiful and enigmatic. <strong>Atticus</strong> — To Kill a Mockingbird. Wise and principled — a top dog name. <strong>Scout</strong> — Also from Mockingbird. Curious and brave. <strong>Huckleberry</strong> — Huck Finn. Adventurous and free. <strong>Jane</strong> — Jane Eyre. Strong and self-respecting. <strong>Rochester</strong> — Brooding and complex. <strong>Pip</strong> — Great Expectations. Humble and growing.\"}}]\n31:[\"$\",\"h2\",\"12\",{\"className\":\"text-2xl font-bold mt-10 mb-4 text-gray-900\",\"children\":[\"Fantasy Literature Names\"]}]\n32:[\"$\",\"p\",\"13\",{\"className\":\"text-gray-700 leading-relaxed mb-4\",\"children\":[\"Fantasy literature provides some of the most creative and distinctive names for pets:\"]}]\n33:[\"$\",\"p\",\"14\",{\"className\":\"text-gray-700 leading-relaxed mb-4\",\"dangerouslySetInnerHTML\":{\"__html\":\"<strong>Gandalf</strong> — Wise and powerful, from Lord of the Rings. <strong>Bilbo</strong> — Adventurous and reluctant — great for curious small pets. <strong>Frodo</strong> — Brave and determined. <strong>Samwise</strong> — Loyal beyond measure — perfect for dogs. <strong>Arwen</strong> — Elven beauty and grace. <strong>Legolas</strong> — Swift and keen-eyed. <strong>Aslan</strong> — The great lion from Narnia. Majestic. <strong>Lyra</strong> — His Dark Materials. Curious and daring. <strong>Dumbledore</strong> — Wise and eccentric. <strong>Hermione</strong> — Brilliant and loyal. <strong>Drogon</strong> — From Game of Thrones. Fierce. <strong>Nymeria</strong> — Also from Game of Thrones. Independent and strong.\"}}]\n34:[\"$\",\"h2\",\"15\",{\"className\":\"text-2xl font-bold mt-10 mb-4 text-gray-900\",\"children\":[\"Children's Literature Names\"]}]\n35:[\"$\",\"p\",\"16\",{\"className\":\"text-gray-700 leading-relaxed mb-4\",\"children\":[\"Children's books give us some of the most beloved and whimsical names:\"]}]\n36:[\"$\",\"p\",\"17\",{\"className\":\"text-gray-700 leading-relaxed mb-4\",\"dangerouslySetInnerHTML\":{\"__html\":\"<strong>Paddington</strong> — The polite bear from Peru. <strong>Pooh</strong> — Winnie the Pooh. Sweet and simple. <strong>Tigger</strong> — Bouncy and energetic. <strong>Eeyore</strong> — For melancholic, lovable pets. <strong>Matilda</strong> — Smart and magical. <strong>Charlotte</strong> — Charlotte's Web. Kind and wise. <strong>Wilbur</strong> — Also from Charlotte's Web. <strong>Max</strong> — Where the Wild Things Are. <strong>Pippi</strong> — Pippi Longstocking. Spirited and unconventional. <strong>Alice</strong> — Alice in Wonderland. Curious. <strong>Mad Hatter</strong> — Eccentric and fun (Hatter for short). <strong>Cheshire</strong> — Mischievously grinning.\"}}]\n37:[\"$\",\"h2\",\"18\",{\"className\":\"text-2xl font-bold mt-10 mb-4 text-gray-900\",\"children\":[\"Modern Literary Pet Names\"]}]\n38:[\"$\",\"p\",\"19\",{\"className\":\"text-gray-700 leading-relaxed mb-4\",\"children\":[\"Contemporary literature offers fresh, distinctive names:\"]}]\n39:[\"$\",\"p\",\"20\",{\"className\":\"text-gray-700 leading-relaxed mb-4\",\"dangerouslySetInnerHTML\":{\"__html\":\"<strong>Katniss</strong> — The Hunger Games. Brave and resilient. <strong>Peeta</strong> — Also from Hunger Games. Kind and steadfast. <strong>Hazel</strong> — The Fault in Our Stars. <strong>Lisbeth</strong> — Girl with the Dragon Tattoo. Fierce. <strong>Pi</strong> — Life of Pi. Spiritual and resourceful. <strong>Kvothe</strong> — The Name of the Wind. Clever and talented. <strong>Tris</strong> — Divergent. Courageous. <strong>June</strong> — The Handmaid's Tale. Resilient. <strong>Coraline</strong> — Brave and curious. <strong>Stargirl</strong> — Unique and magnetic.\"}}]\n3a:[\"$\",\"h2\",\"21\",{\"className\":\"text-2xl font-bold mt-10 mb-4 text-gray-900\",\"children\":[\"Famous Animal Characters in Literature\"]}]\n3b:[\"$\",\"p\",\"22\",{\"className\":\"text-gray-700 leading-relaxed mb-4\",\"children\":[\"Some of literature's most beloved characters are animals themselves — naming your pet after one is a meta-delight:\"]}]\n3c:[\"$\",\"p\",\"23\",{\"className\":\"text-gray-700 leading-relaxed mb-4\",\"dangerouslySetInnerHTML\":{\"__html\":\"<strong>Buck</strong> — Call of the Wild. The ultimate dog name. <strong>White Fang</strong> — Also Jack London. <strong>Moby</strong> — Moby Dick. For large, white pets. <strong>Hedwig</strong> — Harry Potter's loyal owl. <strong>Crookshanks</strong> — Hermione's clever cat. <strong>Aslan</strong> — The great lion. <strong>Boxer</strong> — Animal Farm. Strong and loyal. <strong>Black Beauty</strong> — The iconic horse. <strong>Babe</strong> — The gallant pig. <strong>Stuart</strong> — Stuart Little. For small, adventurous pets. <strong>Ralph</strong> — The Mouse and the Motorcycle. <strong>Toto</strong> — Dorothy's faithful companion from The Wizard of Oz.\"}}]\n3d:[\"$\",\"p\",\"24\",{\"className\":\"text-gray-700 leading-relaxed mb-4\",\"children\":[\"Explore our name generators for \",[\"$\",\"$L3\",\"32\",{\"href\":\"/animal/andean-cock-of-the-rock/\",\"className\":\"text-primary font-semibold hover:underline\",\"children\":[\"Andean Cock-of-the-Rock\",\" Name Generator\"]}],\", \",[\"$\",\"$L3\",\"59\",{\"href\":\"/animal/amur-leopard/\",\"className\":\"text-primary font-semibold hover:underline\",\"children\":[\"Amur Leopard\",\" Name Generator\"]}],\", \",[\"$\",\"$L3\",\"75\",{\"href\":\"/animal/alpine-salamander/\",\"className\":\"text-primary font-semibold hover:underline\",\"children\":[\"Alpine Salamander\",\" Name Generator\"]}],\", \",[\"$\",\"$L3\",\"96\",{\"href\":\"/animal/american-kestrel/\",\"className\":\"text-primary font-semibold hover:underline\",\"children\":[\"American Kestrel\",\" Name Generator\"]}],\", and \",[\"$\",\"$L3\",\"120\",{\"href\":\"/animal/airedale-terrier/\",\"className\":\"text-primary font-semibold hover:underline\",\"children\":[\"Airedale Terrier\",\" Name Generator\"]}],\" to find the perfect name for your companion.\"]}]\n3e:[\"$\",\"h2\",\"25\",{\"className\":\"text-2xl font-bold mt-10 mb-4 text-gray-900\",\"children\":[\"Frequently Asked Questions\"]}]\n3f:[\"$\",\"p\",\"26\",{\"className\":\"text-gray-700 leading-relaxed mb-4\",\"children\":[\"Discover more naming ideas: \",[\"$\",\"$L3\",\"28\",{\"href\":\"/animal/jewel-beetle/\",\"className\":\"text-primary font-semibold hover:underline\",\"children\":[\"Jewel Beetle\",\" Name Generator\"]}],\", \",[\"$\",\"$L3\",\"44\",{\"href\":\"/animal/tucuxi/\",\"className\":\"text-primary font-semibold hover:underline\",\"children\":[\"Tucuxi\",\" Name Generator\"]}],\", \",[\"$\",\"$L3\",\"54\",{\"href\":\"/animal/white-tailed-mongoose/\",\"className\":\"text-primary font-semibold hover:underline\",\"children\":[\"White-Tailed Mongoose\",\" Name Generator\"]}],\", \",[\"$\",\"$L3\",\"79\",{\"href\":\"/animal/giant-otter/\",\"className\":\"text-primary font-semibold hover:underline\",\"children\":[\"Giant Otter\",\" Name Generator\"]}],\", \",[\"$\",\"$L3\",\"94\",{\"href\":\"/animal/northern-mockingbird/\",\"className\":\"text-primary font-semibold hover:underline\",\"children\":[\"Northern Mockingbird\",\" Name Generator\"]}],\", and hundreds more animal name generators.\"]}]\n40:[\"$\",\"section\",null,{\"className\":\"mt-12 bg-white rounded-2xl p-6 border border-gray-100\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold mb-6\",\"children\":\"❓ Frequently Asked Questions\"}],[\"$\",\"div\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"bg-gray-50 rounded-xl p-5 group\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"font-semibold cursor-pointer group-open:text-primary\",\"children\":\"Is it okay to use a literary name if I haven't read the book?\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-gray-600 leading-relaxed\",\"children\":\"While literary names work purely for their sound, we recommend understanding the character's story and values. The name carries more meaning when you know its origin — and fellow book lovers will likely ask about it.\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"bg-gray-50 rounded-xl p-5 group\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"font-semibold cursor-pointer group-open:text-primary\",\"children\":\"What's the most popular literary dog name?\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-gray-600 leading-relaxed\",\"children\":\"Atticus (from To Kill a Mockingbird) has been one of the most popular literary dog names for years, followed by Scout, Gatsby, and Darcy. These names are classic, dignified, and widely recognized.\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"bg-gray-50 rounded-xl p-5 group\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"font-semibold cursor-pointer group-open:text-primary\",\"children\":\"Can I use villain names for pets?\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-gray-600 leading-relaxed\",\"children\":\"Absolutely — villain names often sound great. Names like Iago, Voldemort, or Moriarty can be fun and ironic choices, especially for pets with mischievous personalities. Just be prepared to explain the joke.\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"bg-gray-50 rounded-xl p-5 group\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"font-semibold cursor-pointer group-open:text-primary\",\"children\":\"Are literary names too formal for pets?\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-gray-600 leading-relaxed\",\"children\":\"Not at all. Many literary names have natural nicknames: Fitzwilliam becomes Fitz or Will, Hermione becomes Hermy or Mione, Atticus becomes Atti. You can use the formal name at the vet and the nickname at home.\"}]]}],[\"$\",\"details\",\"4\",{\"className\":\"bg-gray-50 rounded-xl p-5 group\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"font-semibold cursor-pointer group-open:text-primary\",\"children\":\"How do I choose between multiple literary names I love?\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-gray-600 leading-relaxed\",\"children\":\"Try each name for a day. See which one feels most natural when you call your pet. The right name will settle into place quickly — it will feel like it was always meant to be theirs.\"}]]}]]}]]}]\n41:[\"$\",\"section\",null,{\"className\":\"mt-12\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold mb-6\",\"children\":\"🐾 Related Animal Name Generators\"}],[\"$\",\"div\",null,{\"className\":\"grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3\",\"children\":[[\"$\",\"$L3\",\"dragonfish\",{\"href\":\"/animal/dragonfish/\",\"className\":\"bg-white rounded-xl p-4 text-center border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-2xl mb-1\",\"children\":\"🐟\"}],[\"$\",\"div\",null,{\"className\":\"text-sm font-semibold text-gray-700 group-hover:text-primary\",\"children\":\"Dragonfish\"}]]}],[\"$\",\"$L3\",\"norfolk-terrier\",{\"href\":\"/animal/norfolk-terrier/\",\"className\":\"bg-white rounded-xl p-4 text-center border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-2xl mb-1\",\"children\":\"🐕\"}],[\"$\",\"div\",null,{\"className\":\"text-sm font-semibold text-gray-700 group-hover:text-primary\",\"children\":\"Norfolk Terrier\"}]]}],[\"$\",\"$L3\",\"bohemian-waxwing\",{\"href\":\"/animal/bohemian-waxwing/\",\"className\":\"