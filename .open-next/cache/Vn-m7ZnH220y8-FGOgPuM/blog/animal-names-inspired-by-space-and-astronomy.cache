2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-primary font-bold mt-0.5 min-w-[1.5em]\",\"children\":[5,\".\"]}],[\"$\",\"a\",null,{\"href\":\"#myth\",\"className\":\"text-gray-700 hover:text-primary hover:underline transition-colors text-sm leading-relaxed\",\"children\":\"Space Mythology Names\"}]]}],[\"$\",\"li\",\"5\",{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-primary font-bold mt-0.5 min-w-[1.5em]\",\"children\":[6,\".\"]}],[\"$\",\"a\",null,{\"href\":\"#faq\",\"className\":\"text-gray-700 hover:text-primary hover:underline transition-colors text-sm leading-relaxed\",\"children\":\"FAQ\"}]]}]]}]]}],\"$L22\",\"$L23\",\"$L24\",\"$L25\",\"$L26\",\"$L27\",\"$L28\",\"$L29\",\"$L2a\",\"$L2b\",\"$L2c\"]}],\"$L2d\",\"$L2e\",\"$L2f\",\"$L30\",\"$L31\",\"$L32\"]}]\n22:[\"$\",\"p\",\"1\",{\"className\":\"text-gray-700 leading-relaxed mb-4\",\"children\":[\"The cosmos has inspired humanity for millennia. Naming your pet after the stars, planets, and galaxies connects them to the infinite wonder of the universe. Whether you have a bright and energetic \",[\"$\",\"$L3\",\"197\",{\"href\":\"/animal/dog/\",\"className\":\"text-primary font-semibold hover:underline\",\"children\":[\"Dog\",\" Name Generator\"]}],\" or a mysterious and nocturnal \",[\"$\",\"$L3\",\"233\",{\"href\":\"/animal/cat/\",\"className\":\"text-primary font-semibold hover:underline\",\"children\":[\"Cat\",\" Name Generator\"]}],\", space names offer cosmic beauty for every personality.\"]}]\n23:[\"$\",\"h2\",\"2\",{\"className\":\"text-2xl font-bold mt-10 mb-4 text-gray-900\",\"children\":[\"Planet & Moon Names\"]}]\n24:[\"$\",\"p\",\"3\",{\"className\":\"text-gray-700 leading-relaxed mb-4\",\"dangerouslySetInnerHTML\":{\"__html\":\"Planetary names bring cosmic gravitas: <strong>Jupiter</strong>, <strong>Mars</strong>, <strong>Venus</strong>, <strong>Saturn</strong>, <strong>Neptune</strong>, <strong>Mercury</strong>. Moon names are softer and luminous: <strong>Luna</strong>, <strong>Titan</strong>, <strong>Europa</strong>, <strong>Io</strong>, <strong>Callisto</strong>, <strong>Phoebe</strong>, <strong>Rhea</strong>.\"}}]\n25:[\"$\",\"h2\",\"4\",{\"className\":\"text-2xl font-bold mt-10 mb-4 text-gray-900\",\"children\":[\"Star & Constellation Names\"]}]\n26:[\"$\",\"p\",\"5\",{\"className\":\"text-gray-700 leading-relaxed mb-4\",\"dangerouslySetInnerHTML\":{\"__html\":\"Star names shine with brilliance: <strong>Sirius</strong> (the brightest star), <strong>Vega</strong>, <strong>Altair</strong>, <strong>Polaris</strong>, <strong>Rigel</strong>, <strong>Betelgeuse</strong>. Constellation names add meaning: <strong>Orion</strong>, <strong>Lyra</strong>, <strong>Draco</strong>, <strong>Phoenix</strong>, <strong>Cygnus</strong>.\"}}]\n27:[\"$\",\"h2\",\"6\",{\"className\":\"text-2xl font-bold mt-10 mb-4 text-gray-900\",\"children\":[\"Galaxy & Nebula Names\"]}]\n28:[\"$\",\"p\",\"7\",{\"className\":\"text-gray-700 leading-relaxed mb-4\",\"dangerouslySetInnerHTML\":{\"__html\":\"Deep space names evoke the sublime: <strong>Nebula</strong>, <strong>Andromeda</strong>, <strong>Milky</strong> (Way), <strong>Quasar</strong>, <strong>Pulsar</strong>, <strong>Cosmos</strong>, <strong>Stellar</strong>, <strong>Aurora</strong>. These names suggest depth, mystery, and infinite possibility.\"}}]\n29:[\"$\",\"h2\",\"8\",{\"className\":\"text-2xl font-bold mt-10 mb-4 text-gray-900\",\"children\":[\"Astronaut & Space Mission Names\"]}]\n2a:[\"$\",\"p\",\"9\",{\"className\":\"text-gray-700 leading-relaxed mb-4\",\"dangerouslySetInnerHTML\":{\"__html\":\"Honor real space explorers: <strong>Buzz</strong> (Aldrin), <strong>Neil</strong> (Armstrong), <strong>Sally</strong> (Ride), <strong>Laika</strong> (space dog), <strong>Apollo</strong>, <strong>Gemini</strong>, <strong>Voyager</strong>, <strong>Hubble</strong>, <strong>Kepler</strong>.\"}}]\n2b:[\"$\",\"h2\",\"10\",{\"className\":\"text-2xl font-bold mt-10 mb-4 text-gray-900\",\"children\":[\"Space Mythology Names\"]}]\n2c:[\"$\",\"p\",\"11\",{\"className\":\"text-gray-700 leading-relaxed mb-4\",\"dangerouslySetInnerHTML\":{\"__html\":\"Many celestial names trace to mythology: <strong>Diana</strong> (moon goddess), <strong>Selene</strong> (moon), <strong>Helios</strong> (sun), <strong>Sol</strong>, <strong>Ra</strong> (sun god), <strong>Oberon</strong> and <strong>Titania</strong> (moons of Uranus).\"}}]\n2d:[\"$\",\"section\",null,{\"className\":\"mt-12 bg-white rounded-2xl p-6 border border-gray-100\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold mb-6\",\"children\":\"❓ Frequently Asked Questions\"}],[\"$\",\"div\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"bg-gray-50 rounded-xl p-5 group\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"font-semibold cursor-pointer group-open:text-primary\",\"children\":\"Are space names only for science enthusiasts?\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-gray-600 leading-relaxed\",\"children\":\"Not at all! Space names carry universal beauty and wonder. Anyone can appreciate the poetry of naming a pet after the stars regardless of astronomy knowledge.\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"bg-gray-50 rounded-xl p-5 group\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"font-semibold cursor-pointer group-open:text-primary\",\"children\":\"What's the most popular space pet name?\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-gray-600 leading-relaxed\",\"children\":\"Luna is by far the most popular space-inspired pet name, followed by Nova, Stella, Orion, and Cosmo.\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"bg-gray-50 rounded-xl p-5 group\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"font-semibold cursor-pointer group-open:text-primary\",\"children\":\"Can small pets have cosmic names?\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-gray-600 leading-relaxed\",\"childre