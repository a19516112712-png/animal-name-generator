 Post\"}],[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold text-gray-700 group-hover:text-primary mt-1 line-clamp-1\",\"children\":\"Reptile & Amphibian Naming Guide: 100+ Creative Names for Scales, Shells & Slime 🦎\"}]]}],[\"$\",\"$L3\",null,{\"href\":\"/blog/nature-inspired-dog-names-guide/\",\"className\":\"bg-white rounded-xl p-4 border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group text-right\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs text-gray-500\",\"children\":\"Next Post →\"}],[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold text-gray-700 group-hover:text-primary mt-1 line-clamp-1\",\"children\":\"Nature-Inspired Dog Names: 120+ Ideas from Mountains, Rivers & Forests 🌲\"}]]}]]}]\n3f:[\"$\",\"div\",null,{\"className\":\"mt-12 p-6 bg-primary/5 rounded-2xl border border-primary/10 text-center\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-lg font-semibold text-gray-800 mb-2\",\"children\":\"🐾 Ready to find the perfect animal name?\"}],[\"$\",\"p\",null,{\"className\":\"text-gray-600 mb-4\",\"children\":\"Browse our complete collection of 200+ animal name generators — all 100% free.\"}],[\"$\",\"$L3\",null,{\"href\":\"/animals/\",\"className\":\"inline-block bg-primary text-white font-bold px-6 py-3 rounded-full hover:bg-primary-dark transition-colors\",\"children\":\"Browse All Animals →\"}]]}]\n40:[\"$\",\"$L3\",\"best-fish-names-complete-guide\",{\"href\":\"/blog/best-fish-names-complete-guide/\",\"className\":\"bg-white rounded-xl p-5 border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-3xl mb-3\",\"children\":\"🐠\"}],[\"$\",\"span\",null,{\"className\":\"text-xs bg-primary/10 text-primary font-semibold px-2 py-0.5 rounded-full\",\"children\":\"Pet Names\"}],[\"$\",\"h3\",null,{\"className\":\"text-sm font-bold text-gray-800 mt-2 group-hover:text-primary line-clamp-2\",\"children\":\"200+ Best Fish Names: The Complete Guide for Every Aquarium Friend\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-gray-500 mt-1 line-clamp-2\",\"children\":\"Discover the ultimate collection of fish names organized by type, color, and personality. From betta fish to goldfish, find the perfect name for your aquatic pet.\"}]]}]\n41:[\"$\",\"$L3\",\"seasonal-pet-names-winter-summer-fall\",{\"href\":\"/blog/seasonal-pet-names-winter-summer-fall/\",\"className\":\"bg-white rounded-xl p-5 border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-3xl mb-3\",\"children\":\"❄️\"}],[\"$\",\"span\",null,{\"className\":\"text-xs bg-primary/10 text-primary font-semibold px-2 py-0.5 rounded-full\",\"children\":\"Pet Names\"}],[\"$\",\"h3\",null,{\"className\":\"text-sm font-bold text-gray-800 mt-2 group-hover:text-primary line-clamp-2\",\"children\":\"Seasonal Pet Names: 100+ Ideas for Winter, Summer, Spring & Fall Pets ❄️☀️🍂🌸\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-gray-500 mt-1 line-clamp-2\",\"children\":\"Discover 100+ seasonal pet names inspired by winter snow, summer sun, autumn harvest, and spring blooms. Perfect for pets born in or adopted during your favorite season.\"}]]}]\n1a:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n17:null\n1c:[[\"$\",\"title\",\"0\",{\"children\":\"Vintage Pet Names: 100+ Throwback Ideas That Never Go Out of Style 🕰️\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Discover 100+ vintage and retro pet names from the 1920s through 1970s. Classic, timeless names for dogs, cats, and all pets that carry charm, history, and enduring style.\"}],[\"$\",\"link\",\"2\",{\"rel\":\"manifest\",\"href\":\"/manifest.json\",\"crossOrigin\":\"$undefined\"}],[\"$\",\"meta\",\"3\",{\"name\":\"keywords\",\"content\":\"vintage pet n