,\"details\",\"3\",{\"className\":\"bg-gray-50 rounded-xl p-5 group\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"font-semibold cursor-pointer group-open:text-primary\",\"children\":\"Can I name my pet after a real astronaut?\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-gray-600 leading-relaxed\",\"children\":\"Absolutely. Armstrong, Aldrin, Jemison (for Mae Jemison), Ride (for Sally Ride), and Gagarin all honor real space explorers. These names carry genuine historical significance and connect pets to humanity's actual achievements in space exploration rather than fictional representations.\"}]]}],[\"$\",\"details\",\"4\",{\"className\":\"bg-gray-50 rounded-xl p-5 group\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"font-semibold cursor-pointer group-open:text-primary\",\"children\":\"What space names work for small pets?\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-gray-600 leading-relaxed\",\"children\":\"Small pets suit cosmic names with size-contrast charm: naming a hamster Nebula or a guinea pig Galaxy creates wonderful affectionate irony. Asteroid works for tiny, impactful pets. Comet describes small, streaking companions. Pixel captures the digital tiny, combining tech and cosmic naming beautifully.\"}]]}]]}]]}]\n39:[\"$\",\"section\",null,{\"className\":\"mt-12\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold mb-6\",\"children\":\"🐾 Related Animal Name Generators\"}],[\"$\",\"div\",null,{\"className\":\"grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3\",\"children\":[[\"$\",\"$L3\",\"dog\",{\"href\":\"/animal/dog/\",\"className\":\"bg-white rounded-xl p-4 text-center border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-2xl mb-1\",\"children\":\"🐕\"}],[\"$\",\"div\",null,{\"className\":\"text-sm font-semibold text-gray-700 group-hover:text-primary\",\"children\":\"Dog\"}]]}],[\"$\",\"$L3\",\"cat\",{\"href\":\"/animal/cat/\",\"className\":\"bg-white rounded-xl p-4 text-center border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-2xl mb-1\",\"children\":\"🐱\"}],[\"$\",\"div\",null,{\"className\":\"text-sm font-semibold text-gray-700 group-hover:text-primary\",\"children\":\"Cat\"}]]}],[\"$\",\"$L3\",\"hamster\",{\"href\":\"/animal/hamster/\",\"className\":\"bg-white rounded-xl p-4 text-center border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-2xl mb-1\",\"children\":\"🐹\"}],[\"$\",\"div\",null,{\"className\":\"text-sm font-semibold text-gray-700 group-hover:text-primary\",\"children\":\"Hamster\"}]]}],[\"$\",\"$L3\",\"rabbit\",{\"href\":\"/animal/rabbit/\",\"className\":\"bg-white rounded-xl p-4 text-center border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-2xl mb-1\",\"children\":\"🐰\"}],[\"$\",\"div\",null,{\"className\":\"text-sm font-semibold text-gray-700 group-hover:text-primary\",\"children\":\"Rabbit\"}]]}],null,null,[\"$\",\"$L3\",\"gorilla\",{\"href\":\"/animal/gorilla/\",\"className\":\"bg-white rounded-xl p-4 text-center border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-2xl mb-1\",\"children\":\"🦍\"}],[\"$\",\"div\",null,{\"className\":\"text-sm font-semibold text-gray-700 group-hover:text-primary\",\"children\":\"Gorilla\"}]]}],[\"$\",\"$L3\",\"british-shorthair-cat\",{\"href\":\"/animal/british-shorthair-cat/\",\"className\":\"bg-white rounded-xl p-4 text-center border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-2xl mb-1\",\"children\":\"🐱\"}],[\"$\",\"div\",null,{\"className\":\"text-sm font-semibold text-gray-700 group-hover:text-primary\",\"children\":\"British Shorthair\"}]]}]]}]]}]\n3a:[\"$\",\"section\",null,{\"className\":\"mt-12\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold mb-6\",\"children\":\"📖 Related Naming Guides\"}],[\"$\",\"div\",null,{\"className\":\"grid grid-cols-1 sm:grid-cols-2 gap-3\",\"children\":[[\"$\",\"$L3\",\"how-to-name-your-dog\",{\"href\":\"/guide/how-to-name-your-dog/\",\"className\":\"bg-white rounded-xl p-4 border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group flex items-center gap-3\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-2xl\",\"children\":\"📖\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold text-gray-700 group-hover:text-primary\",\"children\":\"How to Name Your Dog — Complete Guide 🐕\"}]]}],[\"$\",\"$L3\",\"how-to-name-your-cat\",{\"href\":\"/guide/how-to-name-your-cat/\",\"className\":\"bg-white rounded-xl p-4 border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group flex items-center gap-3\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-2xl\",\"children\":\"📖\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold text-gray-700 group-hover:text-primary\",\"children\":\"How to Name Your Cat — Complete Guide 🐱\"}]]}],null]}]]}]\n3b:[\"$\",\"section\",null,{\"className\":\"mt-12\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold mb-6\",\"children\":\"📝 Related Articles\"}],[\"$\",\"div\",null,{\"className\":\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4\",\"children\":[[\"$\",\"$L3\",\"animal-names-inspired-by-space-and-astronomy\",{\"href\":\"/blog/animal-names-inspired-by-space-and-astronomy/\",\"className\":\"bg-white rounded-xl p-5 border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-3xl mb-3\",\"children\":