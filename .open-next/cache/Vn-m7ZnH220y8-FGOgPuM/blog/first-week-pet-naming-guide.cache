}]]}],[\"$\",\"$L3\",\"names-that-match-pet-colors\",{\"href\":\"/blog/names-that-match-pet-colors/\",\"className\":\"bg-white rounded-xl p-5 border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-3xl mb-3\",\"children\":\"🎨\"}],[\"$\",\"span\",null,{\"className\":\"text-xs bg-primary/10 text-primary font-semibold px-2 py-0.5 rounded-full\",\"children\":\"Pet Names\"}],[\"$\",\"h3\",null,{\"className\":\"text-sm font-bold text-gray-800 mt-2 group-hover:text-primary line-clamp-2\",\"children\":\"Names That Match Your Pet's Colors: A Complete Visual Guide 🎨\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-gray-500 mt-1 line-clamp-2\",\"children\":\"Match your pet's name to their unique coat color. From snowy whites to midnight blacks, golden oranges to cool grays — discover 120+ color-inspired names organized by shade for dogs, cats, and all pets.\"}]]}],[\"$\",\"$L3\",\"trending-pet-names-2025\",{\"href\":\"/blog/trending-pet-names-2025/\",\"className\":\"bg-white rounded-xl p-5 border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-3xl mb-3\",\"children\":\"🔥\"}],[\"$\",\"span\",null,{\"className\":\"text-xs bg-primary/10 text-primary font-semibold px-2 py-0.5 rounded-full\",\"children\":\"Pet Names\"}],[\"$\",\"h3\",null,{\"className\":\"text-sm font-bold text-gray-800 mt-2 group-hover:text-primary line-clamp-2\",\"children\":\"Trending Pet Names 2025: What's Hot Right Now 🔥\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-gray-500 mt-1 line-clamp-2\",\"children\":\"Discover the hottest trending pet names for 2025. From vintage comebacks to pop culture influences, see what's shaping pet naming this year with 120+ trending names for dogs, cats, and all pets.\"}]]}],[\"$\",\"$L3\",\"best-fish-names-complete-guide\",{\"href\":\"/blog/best-fish-names-complete-guide/\",\"cl