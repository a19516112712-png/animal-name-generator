beauty in the natural world.\"}]]}],[\"$\",\"$L9\",\"the-ultimate-guide-to-playful-snowy-owl-names-175-ideas-for-every-snowy-owl-owner\",{\"href\":\"/blog/the-ultimate-guide-to-playful-snowy-owl-names-175-ideas-for-every-snowy-owl-owner/\",\"className\":\"bg-white rounded-xl p-5 border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-3xl mb-3\",\"children\":\"🐾\"}],[\"$\",\"span\",null,{\"className\":\"text-xs bg-primary/10 text-primary font-semibold px-2 py-0.5 rounded-full\",\"children\":\"Snowy Owl Names\"}],[\"$\",\"h3\",null,{\"className\":\"text-sm font-bold text-gray-800 mt-2 group-hover:text-primary line-clamp-2\",\"children\":\"The Ultimate Guide to Playful Snowy Owl Names: 175+ Ideas for Every Snowy Owl Owner\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-gray-500 mt-1 line-clamp-2\",\"children\":\"From inspired by music inspirations to classic favorites, discover 175+ playful snowy owl names that capture your snowy owl's unique personality.\"}]]}],[\"$\",\"$L9\",\"the-ultimate-guide-to-best-sulcata-tortoise-names-60-ideas-for-every-sulcata-tortoise-owner\",{\"href\":\"/blog/the-ultimate-guide-to-best-sulcata-tortoise-names-60-ideas-for-every-sulcata-tortoise-owner/\",\"className\":\"bg-white rounded-xl p-5 border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-3xl mb-3\",\"children\":\"🐱\"}],[\"$\",\"span\",null,{\"className\":\"text-xs bg-primary/10 text-primary font-semibold px-2 py-0.5 rounded-full\",\"children\":\"Sulcata Tortoise Names\"}],[\"$\",\"h3\",null,{\"className\":\"text-sm font-bold text-gray-800 mt-2 group-hover:text-primary line-clamp-2\",\"children\":\"The Ultimate Guide to Best Sulcata Tortoise Names: 60+ Ideas for Every Sulcata Tortoise Owner\"}],\"$L32\"]}],\"$L33\",\"$L34\"]}]]}]\n29:[\"$\",\"nav\",null,{\"className\":\"mt-12 grid grid-col