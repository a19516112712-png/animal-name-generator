]}],[\"$\",\"$L3\",\"artistic-creative-pet-names-inspired\",{\"href\":\"/blog/artistic-creative-pet-names-inspired/\",\"className\":\"bg-white rounded-xl p-5 border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-3xl mb-3\",\"children\":\"🎨\"}],[\"$\",\"span\",null,{\"className\":\"text-xs bg-primary/10 text-primary font-semibold px-2 py-0.5 rounded-full\",\"children\":\"Creative Names\"}],[\"$\",\"h3\",null,{\"className\":\"text-sm font-bold text-gray-800 mt-2 group-hover:text-primary line-clamp-2\",\"children\":\"Artistic and Creative Pet Names: 140+ Inspired Ideas from Art, Music, and Literature\"}],[\"$\",\"p\",null,{\"className\":\"text-xs text-gray-500 mt-1 line-clamp-2\",\"children\":\"140+ artistic pet names from famous painters, composers, writers, and creative movements. Beautiful, cultured names for pets with artistic souls and creative spirits.\"}]]}],\"$L48\",\"$L49\"]}]]}]\n45:[\"$\",\"nav\",null,{\"className\":\"mt-12 grid grid-cols-2 gap-4\",\"aria-label\":\"Post navigation\",\"children\":[[\"$\",\"$L3\",null,{\"href\":\"/blog/animal-naming-traditions-around-the-world/\",\"className\":\"bg-white rounded-xl p-4 border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group text-left\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs text-gray-500\",\"children\":\"← Previous Post\"}],[\"$\",\"p\",null,{\"className\":\"text-sm font-semibold text-gray-700 group-hover:text-primary mt-1 line-clamp-1\",\"children\":\"Animal Naming Traditions Around the World: How Different Cultures Name Their Pets\"}]]}],[\"$\",\"$L3\",null,{\"href\":\"/blog/animal-names-from-folklore-mythology-world-cultures/\",\"className\":\"bg-white rounded-xl p-4 border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group text-right\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-xs text-gray-500\",\"chil