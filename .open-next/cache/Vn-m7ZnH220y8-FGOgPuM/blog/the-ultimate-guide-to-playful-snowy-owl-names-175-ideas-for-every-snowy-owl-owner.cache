g\"}]]}],[\"$\",\"$L9\",\"sebae-clownfish\",{\"href\":\"/animal/sebae-clownfish/\",\"className\":\"bg-white rounded-xl p-4 text-center border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-2xl mb-1\",\"children\":\"🐠\"}],[\"$\",\"div\",null,{\"className\":\"text-sm font-semibold text-gray-700 group-hover:text-primary\",\"children\":\"Sebae Clownfish\"}]]}]]}]]}]\n35:[\"$\",\"section\",null,{\"className\":\"mt-12\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold mb-6\",\"children\":\"📖 Related Naming Guides\"}],[\"$\",\"div\",null,{\"className\":\"grid grid-cols-1 sm:grid-cols-2 gap-3\",\"children\":[[\"$\",\"$L9\",\"creative-horse-names\",{\"href\":\"/guide/creative-horse-names/\",\"className\":\"bg-white rounded-xl p-4 border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group flex items-center gap-3\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-2xl\",\"children\":\"📖\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold text-gray-700 group-hover:text-primary\",\"children\":\"Creative Horse Names — Top Creative Picks 🐴\"}]]}],[\"$\",\"$L9\",\"how-to-name-your-lovebird\",{\"href\":\"/guide/how-to-name-your-lovebird/\",\"className\":\"bg-white rounded-xl p-4 border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group flex items-center gap-3\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-2xl\",\"children\":\"📖\"}],[\"$\",\"span\",null,{\"className\":\"text-sm font-semibold text-gray-700 group-hover:text-primary\",\"children\":\"How to Name Your Lovebird — Complete Guide 🦜\"}]]}],[\"$\",\"$L9\",\"icelandic-animal-names\",{\"href\":\"/guide/icelandic-animal-names/\",\"className\":\"bg-white rounded-xl p-4 border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group flex items-center gap-3\",\"children\":[[\"$\",\"span\