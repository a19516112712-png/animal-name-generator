\"]}]\n2a:[\"$\",\"p\",\"7\",{\"className\":\"text-gray-700 leading-relaxed mb-4\",\"dangerouslySetInnerHTML\":{\"__html\":\"Drink names are sophisticated and unique. <strong>Mocha</strong>, <strong>Latte</strong>, <strong>Espresso</strong>, <strong>Chai</strong>, <strong>Cappuccino</strong>, <strong>Matcha</strong>, <strong>Cocoa</strong>, <strong>Cola</strong>, and <strong>Boba</strong> bring café culture to your pet's identity.\"}}]\n2b:[\"$\",\"h2\",\"8\",{\"className\":\"text-2xl font-bold mt-10 mb-4 text-gray-900\",\"children\":[\"Fruit & Vegetable Names\"]}]\n2c:[\"$\",\"p\",\"9\",{\"className\":\"text-gray-700 leading-relaxed mb-4\",\"dangerouslySetInnerHTML\":{\"__html\":\"Produce names are colorful and cheerful. <strong>Mango</strong>, <strong>Peach</strong>, <strong>Kiwi</strong>, <strong>Berry</strong>, <strong>Olive</strong>, <strong>Pumpkin</strong>, <strong>Bean</strong>, <strong>Basil</strong>, and <strong>Fig</strong> make wonderfully distinctive pet names.\"}}]\n2d:[\"$\",\"h2\",\"10\",{\"className\":\"text-2xl font-bold mt-10 mb-4 text-gray-900\",\"children\":[\"Spice & Herb Names\"]}]\n2e:[\"$\",\"p\",\"11\",{\"className\":\"text-gray-700 leading-relaxed mb-4\",\"dangerouslySetInnerHTML\":{\"__html\":\"Spice names add warmth and character. <strong>Pepper</strong>, <strong>Ginger</strong>, <strong>Nutmeg</strong>, <strong>Cinnamon</strong>, <strong>Sage</strong>, <strong>Clove</strong>, <strong>Paprika</strong>, <strong>Saffron</strong>, and <strong>Anise</strong> suggest a pet with personality and zing.\"}}]\n2f:[\"$\",\"section\",null,{\"className\":\"mt-12 bg-white rounded-2xl p-6 border border-gray-100\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold mb-6\",\"children\":\"❓ Frequently Asked Questions\"}],[\"$\",\"div\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"bg-gray-50 rounded-xl p-5 group\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"font-semibold cursor-pointe