,\"children\":\"Naming a baby animal? Discover the sweetest names perfect for puppies, kittens, chicks, and all baby animals. Small but mighty cute!\"}]]}]\n1a:[[\"$\",\"meta\",\"0\",{\"charSet\":\"utf-8\"}],[\"$\",\"meta\",\"1\",{\"name\":\"viewport\",\"content\":\"width=device-width, initial-scale=1\"}]]\n17:null\n1c:[[\"$\",\"title\",\"0\",{\"children\":\"Cat Names by Personality Type: Find Your Feline's Perfect Match 🐱\"}],[\"$\",\"meta\",\"1\",{\"name\":\"description\",\"content\":\"Match your cat's one-of-a-kind personality with the perfect name. From regal rulers to goofy goofballs, cuddly lap cats to adventurous explorers — discover 150+ personality-matched cat names organized by temperament.\"}],[\"$\",\"link\",\"2\",{\"rel\":\"manifest\",\"href\":\"/manifest.json\",\"crossOrigin\":\"$undefined\"}],[\"$\",\"meta\",\"3\",{\"name\":\"keywords\",\"content\":\"cat names, kitten names, cat personality, unique cat names\"}],[\"$\",\"meta\",\"4\",{\"name\":\"robots\",\"content\":\"index, follow\"}],[\"$\",\"meta\",\"5\",{\"name\":\"p:domain_verify\",\"content\":\"acc18c9aa2855ead49c874b6cac9cb61\"}],[\"$\",\"link\",\"6\",{\"rel\":\"canonical\",\"href\":\"https://bestanimalnames.com/blog/cat-names-by-personality/\"}],[\"$\",\"meta\",\"7\",{\"property\":\"og:title\",\"content\":\"Cat Names by Personality Type: Find Your Feline's Perfect Match 🐱\"}],[\"$\",\"meta\",\"8\",{\"property\":\"og:description\",\"content\":\"Match your cat's one-of-a-kind personality with the perfect name. From regal rulers to goofy goofballs, cuddly lap cats to adventurous explorers — discover 150+ personality-matched cat names organized by temperament.\"}],[\"$\",\"meta\",\"9\",{\"property\":\"og:type\",\"content\":\"article\"}],[\"$\",\"meta\",\"10\",{\"name\":\"twitter:card\",\"content\":\"summary_large_image\"}],[\"$\",\"meta\",\"11\",{\"name\":\"twitter:title\",\"content\":\"Cat Names by Personality Type: Find Your Feline's Perfect Match 🐱\"}],[\"$\",\"meta\",\"12\",{\"name\":\"twitter