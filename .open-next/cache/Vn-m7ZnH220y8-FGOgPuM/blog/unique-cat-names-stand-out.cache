xl p-5 group\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"className\\\":\\\"font-semibold cursor-pointer group-open:text-primary\\\",\\\"children\\\":\\\"Should my cat's name match its personality?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-3 text-gray-600 leading-relaxed\\\",\\\"children\\\":\\\"It helps! A regal, dignified cat might suit Duchess or Emperor, while a goofy, playful cat might be better as Noodle or Waffles. Observe your cat for a few days before deciding — their personality will guide you.\\\"}]]}],[\\\"$\\\",\\\"details\\\",\\\"4\\\",{\\\"className\\\":\\\"bg-gray-50 rounded-xl p-5 group\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"className\\\":\\\"font-semibold cursor-pointer group-open:text-primary\\\",\\\"children\\\":\\\"Can a unique name be too complicated?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-3 text-gray-600 leading-relaxed\\\",\\\"children\\\":\\\"While creativity is great, avoid names that are too long or hard to pronounce. A unique but pronounceable name (2-3 syllables max) works best. You'll be saying it many times a day!\\\"}]]}]]}]]}]\\n\"])</script><script>self.__next_f.push([1,\"6e:[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"mt-12\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl font-bold mb-6\\\",\\\"children\\\":\\\"🐾 Related Animal Name Generators\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"$L3\\\",\\\"cat\\\",{\\\"href\\\":\\\"/animal/cat/\\\",\\\"className\\\":\\\"bg-white rounded-xl p-4 text-center border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group\\\",\\\"children\\\":[[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"text-2xl mb-1\\\",\\\"children\\\":\\\"🐱\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"text-sm font-semibold text-gray-700 group-hover:text-primary\\\",