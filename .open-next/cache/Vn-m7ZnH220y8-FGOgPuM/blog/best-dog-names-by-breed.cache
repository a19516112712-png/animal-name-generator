ounded-2xl border border-primary/10 text-center\",\"children\":[[\"$\",\"p\",null,{\"className\":\"text-lg font-semibold text-gray-800 mb-2\",\"children\":\"🐾 Ready to find the perfect animal name?\"}],[\"$\",\"p\",null,{\"className\":\"text-gray-600 mb-4\",\"children\":\"Browse our complete collection of 200+ animal name generators — all 100% free.\"}],[\"$\",\"$L9\",null,{\"href\":\"/animals/\",\"className\":\"inline-block bg-primary text-white font-bold px-6 py-3 rounded-full hover:bg-primary-dark transition-colors\",\"children\":\"Browse All Animals →\"}]]}]\n30:null\n31:[\"$\",\"details\",\"4\",{\"className\":\"bg-gray-50 rounded-xl p-5 group\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"font-semibold cursor-pointer group-open:text-primary\",\"children\":\"How long should a dog's name be for best results?\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-gray-600 leading-relaxed\",\"children\":\"Two syllables is widely considered optimal by veterinarians, professional trainers, and canine behaviorists. Two-syllable names like Cooper, Luna, Bella, and Charlie are long enough to be clearly distinct from other everyday sounds but short enough for quick, easy recognition and response. One-syllable names like Max, Jack, or Duke absolutely work fine in practice, though they can occasionally be confused with other short sounds in a busy environment. Three or more syllables — Alexander, Christopher, Elizabeth — will almost inevitably be shortened to nicknames in daily use anyway, so plan for that natural linguistic compression.\"}]]}]\n32:[\"$\",\"$L9\",\"small-dog-names-complete-guide\",{\"href\":\"/blog/small-dog-names-complete-guide/\",\"className\":\"bg-white rounded-xl p-5 border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-3xl mb-3\",\"children\":\"🐾\"}],[\"$\",\"span\",null,{\"className\":\"text-xs bg-primary/10 text-primary font-semibold px-2 py-0.5 rou