ef\":\"/animals/\",\"className\":\"inline-block bg-primary text-white font-bold px-6 py-3 rounded-full hover:bg-primary-dark transition-colors\",\"children\":\"Browse All Animals →\"}]]}]\n39:[\"$\",\"details\",\"6\",{\"className\":\"bg-gray-50 rounded-xl p-5 group\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"font-semibold cursor-pointer group-open:text-primary\",\"children\":\"How do I know if a courage name fits my pet's personality?\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-gray-600 leading-relaxed\",\"children\":\"Observe your pet for a few days. Does your cat fearlessly explore every corner? Does your small dog stand up to bigger dogs at the park? Does your rescue pet show remarkable trust despite their past? Courage manifests differently in every animal. Match the name to the specific kind of bravery you observe — whether it's boldness, resilience, quiet confidence, or protective instinct.\"}]]}]\n3a:[\"$\",\"div\",null,{\"className\":\"text-2xl mb-1\",\"children\":\"🐦\"}]\n3b:[\"$\",\"div\",null,{\"className\":\"text-sm font-semibold text-gray-700 group-hover:text-primary\",\"children\":\"Vulturine Guineafowl\"}]\n3c:[\"$\",\"$L3\",\"cashmere-goat\",{\"href\":\"/animal/cashmere-goat/\",\"className\":\"bg-white rounded-xl p-4 text-center border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-2xl mb-1\",\"children\":\"🐐\"}],[\"$\",\"div\",null,{\"className\":\"text-sm font-semibold text-gray-700 group-hover:text-primary\",\"children\":\"Cashmere Goat\"}]]}]\n3d:[\"$\",\"$L3\",\"killer-whale\",{\"href\":\"/animal/killer-whale/\",\"className\":\"bg-white rounded-xl p-4 text-center border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-2xl mb-1\",\"children\":\"🐋\"}],[\"$\",\"div\",null,{\"className\":\"text-sm font-semibold text-gray-700 group-hover:text