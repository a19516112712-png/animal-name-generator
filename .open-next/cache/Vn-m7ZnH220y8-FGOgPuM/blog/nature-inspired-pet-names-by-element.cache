gray-100 text-gray-600 px-3 py-1 rounded-full\",\"children\":\"element pet names\"}],[\"$\",\"span\",\"earth pet names\",{\"className\":\"text-xs bg-gray-100 text-gray-600 px-3 py-1 rounded-full\",\"children\":\"earth pet names\"}],[\"$\",\"span\",\"water pet names\",{\"className\":\"text-xs bg-gray-100 text-gray-600 px-3 py-1 rounded-full\",\"children\":\"water pet names\"}],[\"$\",\"span\",\"fire pet names\",{\"className\":\"text-xs bg-gray-100 text-gray-600 px-3 py-1 rounded-full\",\"children\":\"fire pet names\"}],[\"$\",\"span\",\"air pet names\",{\"className\":\"text-xs bg-gray-100 text-gray-600 px-3 py-1 rounded-full\",\"children\":\"air pet names\"}],[\"$\",\"span\",\"nature inspired pet names\",{\"className\":\"text-xs bg-gray-100 text-gray-600 px-3 py-1 rounded-full\",\"children\":\"nature inspired pet names\"}]]}]]}],[\"$\",\"div\",null,{\"className\":\"prose prose-lg max-w-none\",\"children\":[[\"$\",\"h2\",\"0\",{\"className\":\"text-2xl font-bold mt-10 mb-4 text-gray-900\",\"children\":[\"📋 Table of Contents\"]}],[\"$\",\"div\",\"1\",{\"className\":\"bg-gradient-to-br from-primary/5 to-indigo-50 rounded-2xl p-6 border border-primary/10 mb-8\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"text-lg font-bold text-gray-800 mb-4\",\"children\":\"📋 Table of Contents\"}],[\"$\",\"ol\",null,{\"className\":\"space-y-2 list-none pl-0\",\"children\":[[\"$\",\"li\",\"0\",{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-primary font-bold mt-0.5 min-w-[1.5em]\",\"children\":[1,\".\"]}],[\"$\",\"a\",null,{\"href\":\"#why\",\"className\":\"text-gray-700 hover:text-primary hover:underline transition-colors text-sm leading-relaxed\",\"children\":\"Why Nature-Inspired Names Are Timeless\"}]]}],[\"$\",\"li\",\"1\",{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-primary font-bold mt-0.5 min-w-[1.5em]\",\"children\":[2,\".\"]}],[\"$\",\"a\",null,{\"href\":\"#earth\",\"className\":\"text-gray-700 hover:text-primary hover:underline transition-colors text-sm leading-relaxed\",\"children\":\"Earth Element Names — Grounded, Strong & Natural\"}]]}],[\"$\",\"li\",\"2\",{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-primary font-bold mt-0.5 min-w-[1.5em]\",\"children\":[3,\".\"]}],[\"$\",\"a\",null,{\"href\":\"#water\",\"className\":\"text-gray-700 hover:text-primary hover:underline transition-colors text-sm leading-relaxed\",\"children\":\"Water Element Names — Flowing, Calm & Refreshing\"}]]}],[\"$\",\"li\",\"3\",{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-primary font-bold mt-0.5 min-w-[1.5em]\",\"children\":[4,\".\"]}],[\"$\",\"a\",null,{\"href\":\"#fire\",\"className\":\"text-gray-700 hover:text-primary hover:underline transition-colors text-sm leading-relaxed\",\"children\":\"Fire Element Names — Passionate, Bright & Energetic\"}]]}],\"$L23\",\"$L24\",\"$L25\"]}]]}],\"$L26\",\"$L27\",\"$L28\",\"$L29\",\"$L2a\",\"$L2b\",\"$L2c\",\"$L2d\",\"$L2e\",\"$L2f\",\"$L30\",\"$L31\",\"$L32\",\"$L33\",\"$L34\",\"$L35\",\"$L36\",\"$L37\",\"$L38\",\"$L39\",\"$L3a\",\"$L3b\",\"$L3c\",\"$L3d\",\"$L3e\",\"$L3f\",\"$L40\",\"$L41\",\"$L42\",\"$L43\",\"$L44\",\"$L45\",\"$L46\"]}],\"$L47\",\"$L48\",\"$L49\",\"$L4a\",\"$L4b\",\"$L4c\"]}]\n23:[\"$\",\"li\",\"4\",{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-primary font-bold mt-0.5 min-w-[1.5em]\",\"children\":[5,\".\"]}],[\"$\",\"a\",null,{\"href\":\"#air\",\"className\":\"text-gray-700 hover:text-primary hover:underline transition-colors text-sm leading-relaxed\",\"children\":\"Air Element Names — Free, Light & Ethereal\"}]]}]\n24:[\"$\",\"li\",\"5\",{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-primary font-bold mt-0.5 min-w-[1.5em]\",\"children\":[6,\".\"]}],[\"$\",\"a\",null,{\"href\":\"#matching\",\"className\":\"text-gray-700 hover:text-primary hover:underline transition-colors text-sm leading-relaxed\",\"children\":\"Matching the Element to Your Pet's Personality\"}]]}]\n25:[\"$\",\"li\",\"6\",{\"className\":\"flex items-start gap-2\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-primary font-bold mt-0.5 min-w-[1.5em]\",\"children\":[7,\".\"]}],[\"$\",\"a\",null,{\"href\":\"#faq\",\"className\":\"text-gray-700 hover:text-primary hover:underline transition-colors text-sm leading-relaxed\",\"children\":\"Frequently Asked Questions\"}]]}]\n26:[\"$\",\"h2\",\"2\",{\"className\":\"text-2xl font-bold mt-10 mb-4 text-gray-900\",\"children\":[\"Why Nature-Inspired Names Are Timeless\"]}]\n27:[\"$\",\"p\",\"3\",{\"className\":\"text-gray-700 leading-relaxed mb-4\",\"children\":[\"Nature-inspired pet names are among the oldest and most enduring naming traditions. Long before human names, pop culture references, or food names became popular for pets, people named their animal companions after the natural world around them — Storm, River, Bear, Sky. These names connect your pet to something ancient and elemental, something that predates our modern categories and fashions.\"]}]\n28:[\"$\",\"p\",\"4\",{\"className\":\"text-gray-700 leading-relaxed mb-4\",\"children\":[\"The four classical elements — Earth, Air, Fire, Water — provide a beautiful organizing framework for nature names. Each element has its own personality and associations, making it easy to find a name that aligns with your pet's unique character. An energetic, warm-natured dog suits Fire names. A calm, gentle cat belongs to Water names. A grounded, steady companion resonates with Earth names. A free-spirited, graceful pet is made for Air names.\"]}]\n29:[\"$\",\"p\",\"5\",{\"className\":\"text-gray-700 leading-relaxed mb-4\",\"children\":[\"At BestAnimalNames.com, we have curated elemental nature names that are both beautiful and practical — names you will enjoy saying every day, that suit your pet's personality, and that carry the timeless beauty of the natural world.\"]}]\n2a:[\"$\",\"h2\",\"6\",{\"className\":\"text-2xl font-bold mt-10 mb-4 text-gray-900\",\"children\":[\"Earth Element Names — Grounded, Strong & Natural\"]}]\n2b:[\"$\",\"p\",\"7\",{\"className\":\"text-gray-700 leading-relaxed mb-4\",\"children\":[\"Earth names evoke stability, strength, growth, and connection to the land. They suit pets who are calm, dependable, nurturing, or simply love the outdoors:\"]}]\n2c:[\"$\",\"p\",\"8\",{\"className\":\"text-gray-700 leading-relaxed mb-4\",\"dangerouslySetInnerHTML\":{\"__html\":\"<strong>Forest names:</strong> Oakley, Willow, Aspen, Cedar, Maple, Birch, Rowan, Juniper, Sequoia, Cypress, Acacia, Laurel, Sage, Briar, Forest itself. <strong>Mountain & stone names:</strong> Cliff, Rocky, Slate, Flint, Onyx, Jasper, Garnet, Jade, Opal, Ruby, Pearl, Diamond, Topaz, Quartz, Sierra, Denali, Summit, Ridge, Canyon. <strong>Earth & ground names:</strong> Terra, Gaia, Clay, Dusty, Sandy, Pebble, Meadow, Prairie, Savannah, Valley, Dale, Glenn. <strong>Garden & plant names:</strong> Basil, Thyme, Clover, Fern, Ivy, Moss, Reed, Bloom, Petal, Blossom, Flora, Hazel, Ginger, Rosemary, Pepper, Cinnamon, Nutmeg, Saffron.\"}}]\n2d:[\"$\",\"p\",\"9\",{\"className\":\"text-gray-700 leading-relaxed mb-4\",\"children\":[\"Earth names are particularly well-suited to: large breed dogs (Oakley, Cliff, Summit), terriers and digging breeds (Sandy, Rocky, Pebble), calm, steady cats (Willow, Sage, Fern), and rabbits and guinea pigs (Clover, Thyme, Basil).\"]}]\n2e:[\"$\",\"h2\",\"10\",{\"className\":\"text-2xl font-bold mt-10 mb-4 text-gray-900\",\"children\":[\"Water Element Names — Flowing, Calm & Refreshing\"]}]\n2f:[\"$\",\"p\",\"11\",{\"className\":\"text-gray-700 leading-relaxed mb-4\",\"children\":[\"Water names evoke fluidity, emotion, depth, and tranquility. They suit pets who are intuitive, gentle, healing, or naturally drawn to water:\"]}]\n30:[\"$\",\"p\",\"12\",{\"className\":\"text-gray-700 leading-relaxed mb-4\",\"dangerouslySetInnerHTML\":{\"__html\":\"<strong>Ocean & sea names:</strong> Marina, Coral, Pearl, Shelly, Cove, Bay, Harbor, Reef, Tide, Tsunami, Ocean, Pacific, Atlantic, Caspian, Coral. <strong>River & lake names:</strong> River, Brook, Creek, Delta, Eddy, Fjord, Lake, Loch, Nile, Amazon, Danube, Shannon, Rio. <strong>Rain & water names:</strong> Rain, Misty, Storm, Dew, Frost, Cloud, Monsoon, Hurricane, Typhoon, Drizzle, Puddle, Splash. <strong>Marine creature names:</strong> Fin, Gill, Nemo, Dory, Marlin, Manta, Orca, Seal, Otter, Walrus, Dolphin, Starfish. <strong>Mythological water names:</strong> Neptune, Poseidon, Triton, Nereid, Undine, Siren, Mermaid, Kelpie, Leviathan, Nessie.\"}}]\n31:[\"$\",\"p\",\"13\",{\"className\":\"text-gray-700 leading-relaxed mb-4\",\"children\":[\"Water names shine for: water-loving breeds like Labradors and Retrievers (River, Marina, Splash), cats with blue or silver coats (Misty, Rain, Dew), fish and aquatic pets (obviously), and calm, therapeutic companion animals (Brook, Bay, Cove).\"]}]\n32:[\"$\",\"h2\",\"14\",{\"className\":\"text-2xl font-bold mt-10 mb-4 text-gray-900\",\"children\":[\"Fire Element Names — Passionate, Bright & Energetic\"]}]\n33:[\"$\",\"p\",\"15\",{\"className\":\"text-gray-700 leading-relaxed mb-4\",\"children\":[\"Fire names radiate energy, passion, warmth, and transformation. They suit pets with big personalities, fiery coats, or boundless enthusiasm:\"]}]\n34:[\"$\",\"p\",\"16\",{\"className\":\"text-gray-700 leading-relaxed mb-4\",\"dangerouslySetInnerHTML\":{\"__html\":\"<strong>Flame & heat names:</strong> Blaze, Ember, Flame, Spark, Kindle, Ash, Cinder, Coal, Torch, Ignis, Scorch. <strong>Sun & light names:</strong> Sunny, Sol, Solar, Helios, Ray, Dawn, Aurora, Solstice, Apollo, Sunshine, Daylight, Summer, August, June. <strong>Color-fire names:</strong> Amber, Crimson, Scarlet, Ruby, Rusty, Ginger, Copper, Bronze, Goldie, Sienna, Ochre, Topaz, Citrine. <strong>Mythological fire names:</strong> Phoenix, Vulcan, Hephaestus, Pele, Agni, Prometheus, Azar, Fintan, Brigid, Vesta, Hestia. <strong>Volcanic names:</strong> Vesuvius, Lava, Magma, Ash, Etna, Crater, Tephra, Caldera.\"}}]\n35:[\"$\",\"p\",\"17\",{\"className\":\"text-gray-700 leading-relaxed mb-4\",\"children\":[\"Fire names are perfect for: red or orange-coated pets (Ember, Amber, Rusty, Ginger), high-energy breeds like Border Collies and Jack Russells (Blaze, Spark, Flash), pets with 'fiery' personalities (Phoenix, Vesuvius, Kindle), and pets that bring warmth to your life (Sunny, Sol, Summer).\"]}]\n36:[\"$\",\"h2\",\"18\",{\"className\":\"text-2xl font-bold mt-10 mb-4 text-gray-900\",\"children\":[\"Air Element Names — Free, Light & Ethereal\"]}]\n37:[\"$\",\"p\",\"19\",{\"className\":\"text-gray-700 leading-relaxed mb-4\",\"children\":[\"Air names suggest freedom, intellect, communication, and lightness of being. They suit graceful, quick, intelligent, or ethereal pets:\"]}]\n38:[\"$\",\"p\",\"20\",{\"className\":\"text-gray-700 leading-relaxed mb-4\",\"dangerouslySetInnerHTML\":{\"__html\":\"<strong>Sky & wind names:</strong> Sky, Skyler, Azure, Celeste, Zephyr, Breeze, Gale, Gust, Twister, Cyclone, Mistral, Chinook, Sirocco, Aura, Ether. <strong>Bird-inspired names:</strong> Raven, Wren, Lark, Robin, Hawk, Falcon, Kestrel, Eagle, Swift, Dove, Sparrow, Starling, Phoenix, Heron, Finch, Piper. <strong>Cloud & weather names:</strong> Cirrus, Nimbus, Stratus, Cloud, Storm, Thunder, Lightning, Bolt, Tempest, Flurry, Snow, Windy. <strong>Celestial & space names:</strong> Luna, Stella, Nova, Orion, Vega, Lyra, Comet, Astro, Cosmo, Nebula, Galaxy, Jupiter, Mars, Venus, Pluto, Eclipse, Solstice. <strong>Sound names:</strong> Echo, Whisper, Sonnet, Lyric, Melody, Harmony, Aria, Cadence, Riff.\"}}]\n39:[\"$\",\"p\",\"21\",{\"className\":\"text-gray-700 leading-relaxed mb-4\",\"children\":[\"Air names suit: sighthounds and fast breeds (Swift, Zephyr, Bolt), birds (obviously — Raven, Wren, Lark), graceful cats (Celeste, Whisper, Aura), white or light-colored pets (Cloud, Snow, Cirrus), and vocal, musical pets (Echo, Lyric, Aria).\"]}]\n3a:[\"$\",\"h2\",\"22\",{\"className\":\"text-2xl font-bold mt-10 mb-4 text-gray-900\",\"children\":[\"Matching the Element to Your Pet's Personality\"]}]\n3b:[\"$\",\"p\",\"23\",{\"className\":\"text-gray-700 leading-relaxed mb-4\",\"children\":[\"The most satisfying elemental names are those that genuinely align with your pet's character. Take time to observe before finalizing:\"]}]\n3c:[\"$\",\"p\",\"24\",{\"className\":\"text-gray-700 leading-relaxed mb-4\",\"dangerouslySetInnerHTML\":{\"__html\":\"<strong>Earth personalities</strong> — calm, grounded, patient, food-motivated, loves routine, enjoys time outdoors but not frantic exercise. Consider: Oakley, Willow, Hazel, Terra, Clay.\"}}]\n3d:[\"$\",\"p\",\"25\",{\"className\":\"text-gray-700 leading-relaxed mb-4\",\"dangerouslySetInnerHTML\":{\"__html\":\"<strong>Water personalities</strong> — intuitive, emotionally responsive, loves swimming or playing in water, gentle with children, has a calming presence. Consider: River, Marina, Brook, Rain, Misty.\"}}]\n3e:[\"$\",\"p\",\"26\",{\"className\":\"text-gray-700 leading-relaxed mb-4\",\"dangerouslySetInnerHTML\":{\"__html\":\"<strong>Fire personalities</strong> — high-energy, enthusiastic, always the center of attention, quick to bark or react, loves to play fetch, has a 'big' presence. Consider: Blaze, Ember, Phoenix, Spark, Sunny.\"}}]\n3f:[\"$\",\"p\",\"27\",{\"className\":\"text-gray-700 leading-relaxed mb-4\",\"dangerouslySetInnerHTML\":{\"__html\":\"<strong>Air personalities</strong> — quick, intelligent, curious, easily distracted, graceful movement, independent but affectionate on their terms. Consider: Zephyr, Sky, Wren, Nova, Echo.\"}}]\n40:[\"$\",\"p\",\"28\",{\"className\":\"text-gray-700 leading-relaxed mb-4\",\"children\":[\"Many pets are blends of elements — a dog might be Earth-Fire (steady but enthusiastic), a cat might be Air-Water (independent but emotionally deep). Trust your intuition about which element best captures your companion's essence.\"]}]\n41:[\"$\",\"p\",\"29\",{\"className\":\"text-gray-700 leading-relaxed mb-4\",\"children\":[\"Explore our name generators for \",[\"$\",\"$L3\",\"32\",{\"href\":\"/animal/african-golden-wolf/\",\"className\":\"text-primary font-semibold hover:underline\",\"children\":[\"African Golden Wolf\",\" Name Generator\"]}],\", \",[\"$\",\"$L3\",\"55\",{\"href\":\"/animal/argonaut/\",\"className\":\"text-primary font-semibold hover:underline\",\"children\":[\"Argonaut\",\" Name Generator\"]}],\", \",[\"$\",\"$L3\",\"67\",{\"href\":\"/animal/african-wild-dog/\",\"className\":\"text-primary font-semibold hover:underline\",\"children\":[\"African Wild Dog\",\" Name Generator\"]}],\", \",[\"$\",\"$L3\",\"87\",{\"href\":\"/animal/anthias/\",\"className\":\"text-primary font-semibold hover:underline\",\"children\":[\"Anthias\",\" Name Generator\"]}],\", and \",[\"$\",\"$L3\",\"102\",{\"href\":\"/animal/african-civet/\",\"className\":\"text-primary font-semibold hover:underline\",\"children\":[\"African Civet\",\" Name Generator\"]}],\" to find the perfect name for your companion.\"]}]\n42:[\"$\",\"h2\",\"30\",{\"className\":\"text-2xl font-bold mt-10 mb-4 text-gray-900\",\"children\":[\"Frequently Asked Questions\"]}]\n43:[\"$\",\"h2\",\"31\",{\"className\":\"text-2xl font-bold mt-10 mb-4 text-gray-900\",\"children\":[\"🌍 A Real-World Naming Story\"]}]\n44:[\"$\",\"p\",\"32\",{\"className\":\"text-gray-700 leading-relaxed mb-4\",\"children\":[\"Sometimes the best names come from the most unexpected places. Take Elena, a wildlife photographer who spent months observing elephantnose-fishs in their natural habitat. When she finally adopted one as a pet, the name came naturally: 'Obsidian' — inspired by the volcanic rock formations where she first encountered the species. 'I didn't choose the name,' Elena recalls. 'The experience chose it for me.'\"]}]\n45:[\"$\",\"p\",\"33\",{\"className\":\"text-gray-700 leading-relaxed mb-4\",\"children\":[\"This story illustrates a deeper naming principle: the most meaningful names aren't always found in lists or generators. They emerge from lived experience — a memorable trip, a childhood memory, a favorite artwork, a piece of music that moved you. These names carry stories, and stories are what transform a simple label into a lifelong connection with your animal companion.\"]}]\n46:[\"$\",\"p\",\"34\",{\"className\":\"text-gray-700 leading-relaxed mb-4\",\"children\":[\"Discover more naming inspiration: \",[\"$\",\"$L3\",\"34\",{\"href\":\"/animal/british-shorthair-cat/\",\"className\":\"text-primary font-semibold hover:underline\",\"children\":[\"British Shorthair\",\" Name Generator\"]}],\", \",[\"$\",\"$L3\",\"59\",{\"href\":\"/animal/rhinoceros-beetle/\",\"className\":\"text-primary font-semibold hover:underline\",\"children\":[\"Rhinoceros Beetle\",\" Name Generator\"]}],\", \",[\"$\",\"$L3\",\"80\",{\"href\":\"/animal/ptarmigan/\",\"className\":\"text-primary font-semibold hover:underline\",\"children\":[\"Ptarmigan\",\" Name Generator\"]}],\", \",[\"$\",\"$L3\",\"93\",{\"href\":\"/animal/galah/\",\"className\":\"text-primary font-semibold hover:underline\",\"children\":[\"Galah\",\" Name Generator\"]}],\", \",[\"$\",\"$L3\",\"102\",{\"href\":\"/animal/pomeranian/\",\"className\":\"text-primary font-semibold hover:underline\",\"children\":[\"Pomeranian\",\" Name Generator\"]}],\", and hundreds more animal name generators at BestAnimalNames.com.\"]}]\n47:[\"$\",\"section\",null,{\"className\":\"mt-12 bg-white rounded-2xl p-6 border border-gray-100\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold mb-6\",\"children\":\"❓ Frequently Asked Questions\"}],[\"$\",\"div\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"details\",\"0\",{\"className\":\"bg-gray-50 rounded-xl p-5 group\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"font-semibold cursor-pointer group-open:text-primary\",\"children\":\"Do pets respond differently to elemental names?\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-gray-600 leading-relaxed\",\"children\":\"Pets respond to sound patterns, not elemental meaning. But the name you choose influences how YOU interact with your pet — naming an energetic dog 'Blaze' might reinforce your appreciation of their energy, while naming them 'Willow' might encourage you to appreciate their calmer moments.\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"bg-gray-50 rounded-xl p-5 group\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"font-semibold cursor-pointer group-open:text-primary\",\"children\":\"Can I use different elemental names for multiple pets?\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-gray-600 leading-relaxed\",\"children\":\"Absolutely. Some owners create elemental families: Ember (fire) and River (water), or Sky (air) and Terra (earth). This creates a beautiful thematic connection between companion animals.\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"bg-gray-50 rounded-xl p-5 group\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"font-semibold cursor-pointer group-open:text-primary\",\"children\":\"What if my pet's personality changes and no longer matches the element?\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-gray-600 leading-relaxed\",\"children\":\"Names grow with pets. A 'Blaze' who mellows with age becomes a warm ember rather than a wild flame — the name adapts. If the mismatch becomes extreme, pets can learn new names with consistent positive reinforcement.\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"bg-gray-50 rounded-xl p-5 group\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"font-semibold cursor-pointer group-open:text-primary\",\"children\":\"Are elemental names too unusual for everyday use?\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-gray-600 leading-relaxed\",\"children\":\"Most elemental names — Willow, River, Sky, Sunny, Amber, Storm — are already mainstream human and pet names. They are distinctive without being strange, familiar without being boring.\"}]]}],[\"$\",\"details\",\"4\",{\"className\":\"bg-gray-50 rounded-xl p-5 group\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"font-semibold cursor-pointer group-open:text-primary\",\"children\":\"What is the most popular elemental pet name right now?\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-gray-600 leading-relaxed\",\"children\":\"Luna (Air/Celestial — meaning moon) is consistently the most popular elemental name, followed by Willow (Earth), River (Water), and Ember (Fire). All four are rising in popularity year over year.\"}]]}],[\"$\",\"details\",\"5\",{\"className\":\"bg-gray-50 rounded-xl p-5 group\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"font-semibold cursor-pointer group-open:text-primary\",\"children\":\"Can I combine elements in a single pet name?\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-gray-600 leading-relaxed\",\"children\":\"Yes — combining elements creates uniquely poetic names. 'Ocean-Fire' for a spirited aquatic pet, 'Earth-Wind' for a grounded yet free-spirited animal, or 'Storm-Flower' for a pet with both intensity and delicacy. Element combinations often tell richer stories than single elements alone.\"}]]}]]}]]}]\n48:[\"$\",\"section\",null,{\"className\":\"mt-12\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold mb-6\",\"children\":\"🐾 Related Animal Name Generators\"}],[\"$\",\"div\",null,{\"className\":\"grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-3\",\"children\":[[\"$\",\"$L3\",\"red-eyed-tree-frog\",{\"href\":\"/animal/red-eyed-tree-frog/\",\"className\":\"bg-white rounded-xl p-4 text-center border border-gray-100 shadow-sm hover:shadow-md hover:border-primary/30 transition-all group\",\"children\":[[\"$\",\"div\",null,{\"className\":\"text-2xl mb-1\",\"ch