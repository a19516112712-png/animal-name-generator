22\\\",\"])</script><script>self.__next_f.push([1,\"{\\\"className\\\":\\\"text-gray-700 leading-relaxed mb-4\\\",\\\"children\\\":[\\\"Explore our name generators for \\\",[\\\"$\\\",\\\"$L3\\\",\\\"32\\\",{\\\"href\\\":\\\"/animal/andean-cock-of-the-rock/\\\",\\\"className\\\":\\\"text-primary font-semibold hover:underline\\\",\\\"children\\\":[\\\"Andean Cock-of-the-Rock\\\",\\\" Name Generator\\\"]}],\\\", \\\",[\\\"$\\\",\\\"$L3\\\",\\\"59\\\",{\\\"href\\\":\\\"/animal/amazon-parrot/\\\",\\\"className\\\":\\\"text-primary font-semibold hover:underline\\\",\\\"children\\\":[\\\"Amazon Parrot\\\",\\\" Name Generator\\\"]}],\\\", \\\",[\\\"$\\\",\\\"$L3\\\",\\\"76\\\",{\\\"href\\\":\\\"/animal/arabian-leopard/\\\",\\\"className\\\":\\\"text-primary font-semibold hover:underline\\\",\\\"children\\\":[\\\"Arabian Leopard\\\",\\\" Name Generator\\\"]}],\\\", \\\",[\\\"$\\\",\\\"$L3\\\",\\\"95\\\",{\\\"href\\\":\\\"/animal/algae-octopus/\\\",\\\"className\\\":\\\"text-primary font-semibold hover:underline\\\",\\\"children\\\":[\\\"Algae Octopus\\\",\\\" Name Generator\\\"]}],\\\", and \\\",[\\\"$\\\",\\\"$L3\\\",\\\"116\\\",{\\\"href\\\":\\\"/animal/airedale-terrier/\\\",\\\"className\\\":\\\"text-primary font-semibold hover:underline\\\",\\\"children\\\":[\\\"Airedale Terrier\\\",\\\" Name Generator\\\"]}],\\\" to find the perfect name for your companion.\\\"]}]\\n35:[\\\"$\\\",\\\"p\\\",\\\"23\\\",{\\\"className\\\":\\\"text-gray-700 leading-relaxed mb-4\\\",\\\"children\\\":[\\\"Texture-based food names add another dimension: Fluffy pets suit Marshmallow, Whipped Cream, or Meringue. Smooth, sleek pets match Olive, Espresso, or Sashimi. Round, plump pets inspire Dumpling, Meatball, or Truffle. Multi-colored pets suggest Neapolitan, S'mores, or Trail Mix. Size also guides food naming: tiny pets suit Peanut, Sprout, or Pea. Large pets match Gumbo, Burrito, or Sub. A fluffy white dog named Coconut or Marshmallow makes instant, joyful sense. A sleek black cat named Espresso or Caviar feels inevitable once heard. These appearance-matched food names transform physical characteristics into memorable features.\\\"]}]\\n\"])</script><script>self.__next_f.push([1,\"36:[\\\"$\\\",\\\"section\\\",null,{\\\"className\\\":\\\"mt-12 bg-white rounded-2xl p-6 border border-gray-100\\\",\\\"children\\\":[[\\\"$\\\",\\\"h2\\\",null,{\\\"className\\\":\\\"text-2xl font-bold mb-6\\\",\\\"children\\\":\\\"❓ Frequently Asked Questions\\\"}],[\\\"$\\\",\\\"div\\\",null,{\\\"className\\\":\\\"space-y-3\\\",\\\"children\\\":[[\\\"$\\\",\\\"details\\\",\\\"0\\\",{\\\"className\\\":\\\"bg-gray-50 rounded-xl p-5 group\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"className\\\":\\\"font-semibold cursor-pointer group-open:text-primary\\\",\\\"children\\\":\\\"What are the most popular food names for dogs?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-3 text-gray-600 leading-relaxed\\\",\\\"children\\\":\\\"The most popular food names for dogs include Cookie, Peanut, Mocha, Biscuit, Ginger, Olive, Pepper, Muffin, Honey, and Coco. Cookie and Peanut consistently rank among the top food pet names across all species for their universal appeal, short pronunciation, and positive emotional associations.\\\"}]]}],[\\\"$\\\",\\\"details\\\",\\\"1\\\",{\\\"className\\\":\\\"bg-gray-50 rounded-xl p-5 group\\\",\\\"children\\\":[[\\\"$\\\",\\\"summary\\\",null,{\\\"className\\\":\\\"font-semibold cursor-pointer group-open:text-primary\\\",\\\"children\\\":\\\"Are food names too silly for serious pets?\\\"}],[\\\"$\\\",\\\"p\\\",null,{\\\"className\\\":\\\"mt-3 text-gray-600 leading-relaxed\\\",\\\"children\\\":\\\"Food names can range from playful like Waffles and Taco to sophisticated like Saffron, Brie, Chai, and Miso. The right food name reflects your pet's personality and your own sensibilities. There is no inherent silliness in food naming, only the personality you and your pet bring to the name.\\\"}]]}],[\\\"$\\\",\\\"details\\\",\\\"2\\\