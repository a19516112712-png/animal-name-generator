 Guide\"]}],[\"$\",\"div\",null,{\"className\":\"bg-white rounded-2xl p-8 shadow-sm border border-gray-100\",\"children\":[\"$\",\"ul\",null,{\"className\":\"space-y-3\",\"children\":[[\"$\",\"li\",\"0\",{\"className\":\"flex gap-3 text-gray-700\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-primary font-bold text-lg\",\"children\":[\"0\",1]}],[\"$\",\"span\",null,{\"children\":\"Consider your african elephant's personality — is it bold, shy, playful, or calm?\"}]]}],[\"$\",\"li\",\"1\",{\"className\":\"flex gap-3 text-gray-700\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-primary font-bold text-lg\",\"children\":[\"0\",2]}],[\"$\",\"span\",null,{\"children\":\"Look at physical traits like color, size, or unique markings.\"}]]}],[\"$\",\"li\",\"2\",{\"className\":\"flex gap-3 text-gray-700\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-primary font-bold text-lg\",\"children\":[\"0\",3]}],[\"$\",\"span\",null,{\"children\":\"Say the name out loud — does it sound natural and easy to call?\"}]]}],[\"$\",\"li\",\"3\",{\"className\":\"flex gap-3 text-gray-700\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-primary font-bold text-lg\",\"children\":[\"0\",4]}],[\"$\",\"span\",null,{\"children\":\"Avoid names that sound like common commands or other pets' names.\"}]]}],[\"$\",\"li\",\"4\",{\"className\":\"flex gap-3 text-gray-700\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-primary font-bold text-lg\",\"children\":[\"0\",5]}],[\"$\",\"span\",null,{\"children\":\"Try out a few names and see which one your african elephant responds to best.\"}]]}],[\"$\",\"li\",\"5\",{\"className\":\"flex gap-3 text-gray-700\",\"children\":[[\"$\",\"span\",null,{\"className\":\"text-primary font-bold text-lg\",\"children\":[\"0\",6]}],[\"$\",\"span\",null,{\"children\":\"Short names (1-2 syllables) tend to be easiest for animals to learn and recognize.\"}]]}]]}]}]]}]\na:[\"$\",\"section\",null,{\"className\":\"max-w-7xl mx-auto px-