e\":\"bg-white rounded-xl p-5 shadow-sm border border-gray-100 group\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"font-semibold text-gray-800 cursor-pointer group-open:text-primary\",\"children\":\"What makes a good african civet name?\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-gray-600 leading-relaxed\",\"children\":\"A good african civet name should match your pet's personality, be easy to pronounce and remember, and ideally be one or two syllables. The best names reflect something unique about the animal while being practical for everyday use.\"}]]}],[\"$\",\"details\",\"1\",{\"className\":\"bg-white rounded-xl p-5 shadow-sm border border-gray-100 group\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"font-semibold text-gray-800 cursor-pointer group-open:text-primary\",\"children\":\"Should I choose a name based on my african civet's appearance?\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-gray-600 leading-relaxed\",\"children\":\"Absolutely! african civet's distinctive features make wonderful naming inspiration. Names based on color, size, or markings create an immediate connection and help others appreciate your pet's unique beauty.\"}]]}],[\"$\",\"details\",\"2\",{\"className\":\"bg-white rounded-xl p-5 shadow-sm border border-gray-100 group\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"font-semibold text-gray-800 cursor-pointer group-open:text-primary\",\"children\":\"Can I use a human name for my african civet?\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-gray-600 leading-relaxed\",\"children\":\"Human names are very popular for pets! Names like Charlie, Max, Luna, and Bella work wonderfully and can make your bond with your african civet feel even more personal and meaningful.\"}]]}],[\"$\",\"details\",\"3\",{\"className\":\"bg-white rounded-xl p-5 shadow-sm border border-gray-100 group\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"font-semibold text-gray-800 cursor-pointer group-open:text-primary\",\"children\":\"How many names should I consider before choosing?\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-gray-600 leading-relaxed\",\"children\":\"We recommend shortlisting 3-5 favorite names, then testing them over a few days. Say each name aloud during different activities — the one that consistently feels natural is your winner.\"}]]}],[\"$\",\"details\",\"4\",{\"className\":\"bg-white rounded-xl p-5 shadow-sm border border-gray-100 group\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"font-semibold text-gray-800 cursor-pointer group-open:text-primary\",\"children\":\"Do african civets respond better to certain sounds?\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-gray-600 leading-relaxed\",\"children\":\"Animals tend to respond best to names ending in a vowel sound, especially 'ee' sounds like Charlie or Lucy. Names with hard consonants at the beginning (like K, T, B) also capture attention more effectively.\"}]]}],[\"$\",\"details\",\"5\",{\"className\":\"bg-white rounded-xl p-5 shadow-sm border border-gray-100 group\",\"children\":[[\"$\",\"summary\",null,{\"className\":\"font-semibold text-gray-800 cursor-pointer group-open:text-primary\",\"children\":\"What makes a good name for a African Civet?\"}],[\"$\",\"p\",null,{\"className\":\"mt-3 text-gray-600 leading-relaxed\",\"children\":\"A good African Civet name is clear, easy to pronounce, and fits your pet's personality. Avoid names that sound like commands or household names. The best names often come from observing your African Civet's habits and character — the right name will feel natural after a few days of use.\"}]]}],\"$L1f\"]}]]}]\nc:[\"$\",\"section\",null,{\"className\":\"max-w-3xl mx-auto px-4 py-12\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"text-2xl font-bold text-center mb-8\",\"children\":[\"📖 \",\"African Civet\",\" Naming Guide\"]}],[\"$\",\"div\",null,{\"className\":\"bg-white rounded-2xl p-8 shadow-sm border border-gray-100\",\"children\":[\"$\",\"ul\",null,{\"cla