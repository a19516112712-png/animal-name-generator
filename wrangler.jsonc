{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": ".open-next/worker.js",
	"name": "animal-name-generator",
	"compatibility_date": "2026-07-06",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"alias": {
		"critters": "./critters-shim.mjs",
		"react-dom/server.edge": "react-dom/server.browser"
	},
	"kv_namespaces": [
		{
			"binding": "ANIMAL_DATA",
			"id": "5fe097f6c1ba48d3b5942e02c7ed3b18",
			"preview_id": "5fe097f6c1ba48d3b5942e02c7ed3b18"
		}
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "animal-name-generator"
		}
	],
	"images": {
		"binding": "IMAGES"
	}
}
